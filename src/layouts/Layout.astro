---
import '../styles/global.css';

interface Props {
  title?: string;
  seasonLabel: string;
}

const { title = 'CFB Power Rankings', seasonLabel } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="container">
      <header>
        <!-- Wrapped logo-area in an anchor tag pointing to "/" -->
        <a href="/" class="logo-link">
          <div class="logo-area">
            <h1>CFB Power Rankings</h1>
            <p>Independent power rankings, predictions, win probabilities, and game results.</p>
          </div>
        </a>
        <div class="year-badge">{seasonLabel}</div>
      </header>
      <slot />
    </div>
  </body>
</html>

<style>
  /* Prevents the browser from underlining the link or changing its color */
  .logo-link {
    text-decoration: none;
    color: inherit;
    display: block; /* Ensures the click target takes up the full area */
  }
</style>
