---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.tsx';

interface Props {
  title?: string;       // e.g., "Yaxel Lendeborg" (controls browser tab)
  brand?: string;       // e.g., "College Basketball Ratings" (controls header logo)
  seasonLabel: string;
  lastUpdate?: string;
  subtitle?: string;
}

// Determine which sport we are on
const { pathname } = Astro.url;
const isBasketball = pathname.startsWith('/basketball');

// Set dynamic defaults based on the sport
const defaultBrand = isBasketball ? 'College Basketball Ratings' : 'CFB Power Rankings';
const defaultSubtitle = isBasketball 
  ? 'Player-first RAPM ratings, opponent-adjusted for college basketball.' 
  : 'Independent power rankings, predictions, win probabilities, and game results.';

const {
  title = '',
  brand = defaultBrand,
  seasonLabel,
  lastUpdate: rawDate,
  subtitle = defaultSubtitle,
} = Astro.props;

// Format the date if it's a valid date string
const formattedLastUpdate = rawDate && !isNaN(Date.parse(rawDate))
  ? new Date(rawDate).toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
    })
  : rawDate;

// Format the browser tab title
const pageTitle = title ? `${title} | ${brand}` : brand;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Tab Title: e.g. "Yaxel Lendeborg | College Basketball Ratings" -->
    <title>{pageTitle}</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      const setInitialTheme = () => {
        const stored = localStorage.getItem('theme');
        const prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
        const theme = stored || (prefersLight ? 'light' : 'dark');
        
        document.documentElement.setAttribute('data-theme', theme);
      };

      setInitialTheme();

      // Support Astro View Transitions
      document.addEventListener('astro:after-swap', setInitialTheme);
    </script>
  </head>
  <body>
    <div class="container">
      
      <!-- Global Header (Logo, Title, Dark Mode) -->
      <header>
        <a href={isBasketball ? "/basketball/2027/" : "/"} id="headerLogoLink" class="logo-link">
          <div class="logo-area">
            <h1>{brand}</h1>
            <p>{subtitle}</p>
          </div>
        </a>
        <div class="header-meta">
          <ThemeToggle client:load />
          {formattedLastUpdate && <div class="last-updated">Updated {formattedLastUpdate}</div>}
        </div>
      </header>

      <!-- Page Content gets injected here -->
      <slot />
      
    </div>
  </body>
</html>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const logoLink = document.getElementById('headerLogoLink');
    if (!logoLink) return;

    const path = window.location.pathname;
    
    // Check if we are on a basketball page
    if (path.startsWith('/basketball')) {
      const parts = path.split('/').filter(Boolean); // ['basketball', '2027', 'teams', ...]
      
      // If the second part is a year (e.g., '2027'), set the logo link to `/basketball/2027/`
      if (parts.length > 1 && /^\d{4}$/.test(parts[1])) {
        logoLink.href = `/basketball/${parts[1]}/`;
      } else {
        // If we are just on /basketball/, let the redirect handle it
        logoLink.href = '/basketball/';
      }
    }
  });
</script>

<style>
  .logo-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .header-meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .last-updated {
    font-size: 0.9rem;
    color: var(--text-muted);
    font-weight: 500;
    letter-spacing: 0.02em;
    transition: color 0.2s ease;
  }
</style>