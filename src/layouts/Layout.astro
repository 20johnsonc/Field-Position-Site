---
import '../styles/global.css';

interface Props {
  title?: string;
  seasonLabel: string;
}

const { title = 'Field Position — Analytics Dashboard', seasonLabel } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="container">
      <header>
        <div class="logo-area">
          <h1>Field Position</h1>
          <p>College Football Analytics &amp; Momentum Tracking</p>
        </div>
        <div class="year-badge">{seasonLabel}</div>
      </header>
      <slot />
    </div>
  </body>
</html>
