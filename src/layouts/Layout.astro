---
import '../styles/global.css';

interface Props {
  title?: string;
  seasonLabel: string;
  lastUpdate?: string;
}

const { title = 'CFB Power Rankings', seasonLabel, lastUpdate: rawDate } = Astro.props;

// Format the date if it's a valid date string (e.g., ISO timestamp), otherwise use as-is
const formattedLastUpdate = rawDate && !isNaN(Date.parse(rawDate))
  ? new Date(rawDate).toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
    })
  : rawDate;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="container">
      <header>
        <a href="/" class="logo-link">
          <div class="logo-area">
            <h1>CFB Power Rankings</h1>
            <p>Independent power rankings, predictions, win probabilities, and game results.</p>
          </div>
        </a>
        <div class="header-meta">
          {formattedLastUpdate && <div class="last-updated">Updated {formattedLastUpdate}</div>}
        </div>
      </header>
      <slot />
    </div>
  </body>
</html>

<style>
  .logo-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .header-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
  }

  .last-updated {
    font-size: 0.9rem;
    color: #64748b;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
</style>