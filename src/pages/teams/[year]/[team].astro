    display: inline-block;
    margin-bottom: 1.25rem;
    color: #c084fc; /* Or var(--primary) depending on your theme */
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .week-cell {
    display: flex;
    flex-direction: column;
  }

  .week-num {
    font-weight: 600;
  }

  .post-num {
    font-size: 0.85rem;
    font-weight: 700;
    color: #38bdf8;
  }

  .game-date {
    font-size: 0.75rem;
    color: #94a3b8;
  }

  .badge-tag {
    font-size: 0.65rem;
    font-weight: 500;
    color: #38bdf8;
    background-color: rgba(56, 189, 248, 0.1);
    padding: 1px 4px;
    border-radius: 4px;
    width: max-content;
    margin-top: 2px;
  }

  .opponent-link {
    color: inherit;
    text-decoration: none;
  }

  .opponent-link:hover {
    text-decoration: underline;
  }

  .team-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
    margin-bottom: 4px;
  }

  .style-tag {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 6px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  /* Offense Theme: Vibrant Teal / Cyan */
  .tag-offense {
    background: linear-gradient(135deg, rgba(20, 184, 166, 0.15), rgba(13, 148, 136, 0.25));
    color: #2dd4bf;
    border: 1px solid rgba(45, 212, 191, 0.4);
    box-shadow: 0 0 12px rgba(20, 184, 166, 0.15);
  }

  /* Defense Theme: Sharp Amber / Gold */
  .tag-defense {
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.15), rgba(217, 119, 6, 0.25));
    color: #fbbf24;
    border: 1px solid rgba(251, 191, 36, 0.4);
    box-shadow: 0 0 12px rgba(245, 158, 11, 0.15);
  }

  .tag-neutral {
    background: linear-gradient(135deg, rgba(168, 85, 247, 0.15), rgba(147, 51, 234, 0.25));
    color: #c084fc;
    border: 1px solid rgba(192, 132, 252, 0.4);
    box-shadow: 0 0 12px rgba(168, 85, 247, 0.15);
  }

  .team-header {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .team-header-content {
    flex: 1;
