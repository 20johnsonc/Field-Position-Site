---
import { readFileSync, readdirSync } from 'node:fs';
import { join } from 'node:path';
import Layout from '../../../layouts/Layout.astro';
import TeamTrajectoryChart from '../../../components/TeamTrajectoryChart.tsx';
import gameHistoryRaw from '../../../data/game_history.json';
import trajectoriesRaw from '../../../data/trajectories.json';
import {
  normalizeRankings,
  slugifyTeam,
  formatRating,
  computeRanks,
  computeEfficiencyRange,
  normalizeGameMargins,
} from '../../../lib/data';

const PUBLIC_DATA = join(process.cwd(), 'public', 'data');



function loadJson(relPath: string, fallback: unknown = {}) {
  try {
    return JSON.parse(readFileSync(join(PUBLIC_DATA, relPath), 'utf-8'));
  } catch {
    return fallback;
  }
}

// Reads every rankings/{year}.json once, unwraps the "rankings" key, and
// concatenates — same unwrap pattern as index.astro.
function loadAllRankingsRaw(): any[] {
  const dir = join(PUBLIC_DATA, 'rankings');
  const files = readdirSync(dir).filter((f) => f.endsWith('.json'));
  return files.flatMap((f) => {
    const raw = loadJson(`rankings/${f}`, {});
    return Array.isArray(raw) ? raw : (raw?.rankings ?? []);
  });
}

// Reads every matchups/{year}/week-*.json once and groups by year, so
// getStaticPaths only touches disk a single time no matter how many teams
// need a slice of a given year's games.
function loadAllMatchupsByYear(): Record<number, any[]> {
  const matchupsDir = join(PUBLIC_DATA, 'matchups');
  const years = readdirSync(matchupsDir, { withFileTypes: true })
    .filter((d) => d.isDirectory())
    .map((d) => d.name);

  const byYear: Record<number, any[]> = {};
  for (const year of years) {
    const weekFiles = readdirSync(join(matchupsDir, year)).filter((f) => /^week-\d+\.json$/.test(f));
    const games = weekFiles.flatMap((f) => {
      const raw = loadJson(`matchups/${year}/${f}`, {});
      return Array.isArray(raw) ? raw : (raw?.games ?? []);
    });
    byYear[Number(year)] = games;
  }
  return byYear;
}

interface GameLogEntry {
  week: number;
  opponent: string;
  location: 'Home' | 'Away';
  team_score?: number;
  opponent_score?: number;
  actual_margin: number;
  predicted_margin: number;
  beat_expectation_by: number;
  result: 'W' | 'L';
  is_playoff?: boolean;
  round_name?: string | null;
  bowl_name?: string | null;
}

interface GameHistoryData {
  generated_at: string;
  years: number[];
  teams: Record<string, Record<string, GameLogEntry[]>>;
}

interface TrajectoryGameEntry {
  week: number;
  opponent: string;
  location: 'Home' | 'Away';
  actual_margin: number;
  predicted_margin: number;
  beat_expectation_by: number;
  result: 'W' | 'L';
}

interface TrajectoriesData {
  generated_at: string;
  years: number[];
  teams: Record<string, Record<string, TrajectoryGameEntry[]>>;
}

export function getStaticPaths() {
  const PUBLIC_DATA = join(process.cwd(), 'public', 'data');

  const loadJson = (relPath: string, fallback: unknown = {}) => {
    try {
      return JSON.parse(readFileSync(join(PUBLIC_DATA, relPath), 'utf-8'));
    } catch {
      return fallback;
    }
  };

  const rankingsFiles = readdirSync(join(PUBLIC_DATA, 'rankings')).filter((f) => f.endsWith('.json'));
  const rankingsRaw = rankingsFiles.flatMap((f) => {
    const raw = loadJson(`rankings/${f}`, {});
    return Array.isArray(raw) ? raw : (raw?.rankings ?? []);
  });

  const rankings = normalizeRankings(rankingsRaw as any);

  const matchupsDir = join(PUBLIC_DATA, 'matchups');
  const years = readdirSync(matchupsDir, { withFileTypes: true })
    .filter((d) => d.isDirectory())
    .map((d) => d.name);

  const matchupsByYear: Record<number, any[]> = {};
  for (const year of years) {
    const weekFiles = readdirSync(join(matchupsDir, year)).filter((f) => /^week-\d+\.json$/.test(f));
    matchupsByYear[Number(year)] = weekFiles.flatMap((f) => {
      const raw = loadJson(`matchups/${year}/${f}`, {});
      return Array.isArray(raw) ? raw : (raw?.games ?? []);
    });
  }

  return rankings.map((row) => {
    const ranks = computeRanks(rankings, row.year);
    const totalTeams = rankings.filter((r) => r.year === row.year).length;
    const teamMatchups = (matchupsByYear[row.year] ?? []).filter(
      (g: any) => g.home_team === row.team || g.away_team === row.team
    );

    return {
      params: {
        year: String(row.year),
        team: slugifyTeam(row.team),
      },
      props: { row, ranks: ranks.get(row.team), totalTeams, teamMatchups, allRankings: rankings },
    };
  });
}

const { row, ranks, totalTeams, teamMatchups, allRankings } = Astro.props;

const gameHistory = gameHistoryRaw as GameHistoryData;
const trajectories = trajectoriesRaw as TrajectoriesData;

// Build a lookup set of valid team/year pages to make opponent links safe
const validTeamYears = new Set(allRankings.map((r: any) => `${r.year}-${slugifyTeam(r.team)}`));

// 1. Pull completed game history if available for this team/year
const completedRaw = gameHistory.years?.includes(row.year)
  ? (gameHistory.teams[row.team]?.[String(row.year)] ?? [])
  : [];
const completedGames = normalizeGameMargins(completedRaw).map((g) => ({
  ...g,
  isCompleted: true,
}));

// 2. teamMatchups is already filtered to this team+year in getStaticPaths
// 3. Find which weeks already have completed game results logged
const completedWeeks = new Set(completedGames.map((g) => g.week));

// 4. Map upcoming/scheduled games from the pre-sliced list
const upcomingGames = teamMatchups
  .filter((g: any) => !completedWeeks.has(g.week))
  .map((g: any) => {
    const isHome = g.home_team === row.team;
    const opponent = isHome ? g.away_team : g.home_team;

    const predMargin = isHome
      ? g.predicted_margin
      : (g.predicted_margin != null ? -g.predicted_margin : null);

    let teamWinProb = null;
    if (g.home_win_prob != null) {
      const rawProb = isHome ? g.home_win_prob : (1 - g.home_win_prob);
      teamWinProb = Math.round(rawProb * 100);
    }

    return {
      week: g.week,
      startDate: g.start_date,
      opponent: opponent,
      location: isHome ? 'Home' : 'Away',
      team_score: null,
      opponent_score: null,
      actual_margin: null,
      predicted_margin: predMargin,
      winProb: teamWinProb,
      beat_expectation_by: null,
      result: null,
      isCompleted: false,
      is_playoff: g.is_playoff ?? false,
      round_name: g.round_name ?? null,
      bowl_name: g.bowl_name ?? null,
    };
  });

const teamTrajectory = trajectories.teams?.[row.team]?.[String(row.year)] ?? [];
const { min: effMin, max: effMax } = computeEfficiencyRange(trajectories);

function formatPostseasonLabel(g: any) {
  if (g.bowl_name) return g.bowl_name;
  if (g.round_name) {
    const clean = g.round_name.replace(/_/g, ' ');
    return clean.charAt(0).toUpperCase() + clean.slice(1);
  }
  if (g.is_playoff) return 'Playoff Game';
  return null;
}

// 1. Determine the maximum week present in your team matchups or game history
const maxWeek = Math.max(
  1,
  ...teamMatchups.map((g: any) => g.week),
  ...completedGames.map((g: any) => g.week)
);

const completedMap = new Map(completedGames.map((g) => [g.week, g]));
const upcomingMap = new Map(upcomingGames.map((g) => [g.week, g]));

const fullSchedule = [];
for (let w = 1; w <= maxWeek; w++) {
  if (completedMap.has(w)) {
    fullSchedule.push(completedMap.get(w));
  } else if (upcomingMap.has(w)) {
    fullSchedule.push(upcomingMap.get(w));
  } else {
    // Insert a Bye placeholder for missing weeks
    fullSchedule.push({
      week: w,
      opponent: 'Bye',
      location: 'Home',
      isCompleted: false,
      isBye: true,
      team_score: null,
      opponent_score: null,
      actual_margin: null,
      predicted_margin: null,
      winProb: null,
      beat_expectation_by: null,
      result: null,
    });
  }
}

const sortedGameLog = fullSchedule.sort((a: any, b: any) => {
  const aIsPost = (a.is_playoff || a.bowl_name || a.round_name) && a.week === 1;
  const bIsPost = (b.is_playoff || b.bowl_name || b.round_name) && b.week === 1;

  if (aIsPost && !bIsPost) return 1;
  if (!aIsPost && bIsPost) return -1;

  return a.week - b.week;
});
---

<Layout title={`${row.team} — Team Page`} seasonLabel={`${row.year} Season`}>
  <a href="/" class="back-link" id="backLink">&larr; Return</a>

  <div class="team-header">
    <div class="rank-badge">#{ranks?.overallRank ?? '—'}</div>
    <div class="team-header-content">
      
      <div class="team-title-group">
        <h1>{row.team}</h1>
        
        <div class="subtitle-row">
          <span class="subtitle">{row.conference} · Conf Rank #{ranks?.confRank ?? '—'} ·</span>
          
          <div class="team-year-filter-wrap">
            <select id="teamYearFilter" class="controls select" aria-label="Filter team history by year" data-team={slugifyTeam(row.team)}>
              {Array.from(new Set(allRankings.filter((r: any) => r.team === row.team).map((r: any) => r.year)))
                .sort((a: any, b: any) => b - a)
                .map((yr: any) => (
                  <option value={yr} selected={yr === row.year}>
                    {yr}
                  </option>
                ))}
            </select>
          </div>
        </div>

      </div>
    </div>
  </div>

  <div class="stat-row">
    <div class="stat">
      <span class="label">Net Rating</span>
      <span class="value">{formatRating(row.netRating)}</span>
      <span class="rank-sub">#{ranks?.overallRank ?? '—'} of {totalTeams}</span>
    </div>
    <div class="stat">
      <span class="label">Strength of Schedule</span>
      <span class="value">#{row.sos_rank ?? '—'}</span>
    </div>
    <div class="stat">
      <span class="label">Strength of Record</span>
      <span class="value">#{row.sor_rank ?? '—'}</span>
    </div>
    {row.tags && row.tags.length > 0 && (
      <div class="team-tags">
        {row.tags.map((tag: string) => {
          const lower = tag.toLowerCase();
          const isDef = lower.includes('defense') || lower.includes('stout') || lower.includes('break');
          const isOff = lower.includes('offense') || lower.includes('explosive') || lower.includes('run');
          const tagClass = isDef ? 'tag-defense' : (isOff ? 'tag-offense' : 'tag-neutral');
          return <span class={`style-tag ${tagClass}`}>{tag}</span>;
        })}
      </div>
    )}
  </div>

  <TeamTrajectoryChart
    client:load
    team={row.team}
    trajectory={teamTrajectory}
    games={sortedGameLog}
    yMin={effMin}
    yMax={effMax}
  />

  <h2 class="section-title">Schedule &amp; Results</h2>
  <table class="game-log-table">
    <thead>
      <tr>
        <th>Week</th>
        <th>Opponent</th>
        <th>Result / Prediction</th>
        <th class="num">vs Expectation</th>
      </tr>
    </thead>
    <tbody>
      {sortedGameLog.map((g: any) => {
        const opponentSlug = slugifyTeam(g.opponent);
        const hasPage = validTeamYears.has(`${row.year}-${opponentSlug}`);
        const prefix = g.location === 'Home' ? 'vs ' : '@ ';

        let formattedDate = '';
        if (g.startDate) {
          try {
            const dateObj = new Date(g.startDate);
            if (!isNaN(dateObj.getTime())) {
              formattedDate = dateObj.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
            }
          } catch (e) {}
        }

        const winProb = g.winProb;
        const isFavored = winProb != null && winProb >= 50;
        const probColor = isFavored ? '#4ade80' : '#f87171';

        const scoreLabel = g.isCompleted
          ? (g.team_score != null && g.opponent_score != null
              ? `${g.team_score}–${g.opponent_score}`
              : `${g.actual_margin > 0 ? '+' : ''}${g.actual_margin}`)
          : `Proj: ${g.predicted_margin > 0 ? '+' : ''}${Number(g.predicted_margin).toFixed(1)}`;

        const beatExp = g.isCompleted && g.beat_expectation_by != null ? Number(g.beat_expectation_by) : null;

        const completedWithBeatExp = sortedGameLog.filter((x: any) => x.isCompleted && x.beat_expectation_by != null);
        const maxAbsBeatExp = completedWithBeatExp.length > 0
          ? Math.max(1, ...completedWithBeatExp.map((x: any) => Math.abs(x.beat_expectation_by)))
          : 1;
        const barPct = beatExp != null ? Math.min(100, (Math.abs(beatExp) / maxAbsBeatExp) * 100) : 0;

        const eventLabel = g.bowl_name || g.round_name || (g.is_playoff ? 'Playoff Game' : null);
        const postLabel = formatPostseasonLabel(g);
        const isPostseason = g.is_playoff || g.bowl_name || g.round_name;

        return (
          <tr>
            <td>
              <div class="week-cell">
                {isPostseason ? (
                  <>
                    <span class="week-num post-num">{postLabel}</span>
                    {formattedDate && <span class="game-date">{formattedDate}</span>}
                  </>
                ) : (
                  <>
                    <span class="week-num">Wk {g.week}</span>
                    {formattedDate && <span class="game-date">{formattedDate}</span>}
                    {eventLabel && <span class="badge-tag">{eventLabel}</span>}
                  </>
                )}
              </div>
            </td>
            <td>
              {g.isBye ? (
                <span class="text-muted">Bye</span>
              ) : (
                <>
                  {prefix}
                  {hasPage ? (
                    <a href={`/teams/${row.year}/${opponentSlug}`} class="opponent-link">{g.opponent}</a>
                  ) : (
                    g.opponent
                  )}
                </>
              )}
            </td>
            <td class={g.isBye ? 'text-muted' : (g.isCompleted ? (g.result === 'W' ? 'win' : 'loss') : 'upcoming')}>
              {g.isBye ? (
                <span class="text-muted">—</span>
              ) : (
                <>
                  {g.isCompleted ? `${g.result} ` : ''}
                  {scoreLabel}
                  {!g.isCompleted && winProb != null && (
                    <span class="win-prob-tag" style={{ color: probColor, marginLeft: '12px' }}> {winProb}%</span>
                  )}
                </>
              )}
            </td>
            <td class="num">
              {g.isCompleted && beatExp != null ? (
                <div class="beat-exp-bar-wrap">
                  <span class="beat-exp-value" style={{ color: beatExp >= 0 ? '#4ade80' : '#f87171' }}>
                    {beatExp > 0 ? '+' : ''}{beatExp.toFixed(1)}
                  </span>
                  <div class="beat-exp-bar">
                    <div
                      class="beat-exp-fill"
                      style={{
                        width: `${barPct}%`,
                        marginLeft: beatExp >= 0 ? '50%' : `${50 - barPct}%`,
                        backgroundColor: beatExp >= 0 ? '#22c55e' : '#ef4444',
                      }}
                    />
                  </div>
                </div>
              ) : (
                <span class="text-muted">—</span>
              )}
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>
</Layout>

<script>
  document.getElementById('backLink')?.addEventListener('click', (e) => {
    if (document.referrer) {
      try {
        if (new URL(document.referrer).origin === window.location.origin) {
          e.preventDefault();
          window.history.back();
        }
      } catch {}
    }
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const yearSelect = document.getElementById('teamYearFilter') as HTMLSelectElement | null;
    
    yearSelect?.addEventListener('change', (e) => {
      const select = e.target as HTMLSelectElement;
      const selectedYear = select.value;
      const teamSlug = select.dataset.team;
      if (selectedYear && teamSlug) {
        window.location.href = `/teams/${selectedYear}/${teamSlug}/`;
      }
    });
  });
</script>

