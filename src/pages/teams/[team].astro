---
import Layout from '../../layouts/Layout.astro';
import TeamTrajectoryChart from '../../components/TeamTrajectoryChart.tsx';
import rankingsRaw from '../../data/rankings.json';
import gameHistoryRaw from '../../data/game_history.json';
import trajectoriesRaw from '../../data/trajectories.json';
import { normalizeRankings, slugifyTeam, formatRating, computeRanks } from '../../lib/data';

export function getStaticPaths() {
  const rankings = normalizeRankings(rankingsRaw as any);

  return rankings.map((row) => {
    const ranks = computeRanks(rankings, row.year);
    const totalTeams = rankings.filter((r) => r.year === row.year).length;
    return {
      params: { team: slugifyTeam(row.team) },
      props: { row, ranks: ranks.get(row.team), totalTeams },
    };
  });
}

const { row, ranks, totalTeams } = Astro.props;

const gameHistory = gameHistoryRaw as {
  generated_at: string;
  year: number;
  teams: Record<string, Array<{
    week: number;
    opponent: string;
    location: 'Home' | 'Away';
    actual_margin: number;
    predicted_margin: number;
    beat_expectation_by: number;
    result: 'W' | 'L';
  }>>;
};

const trajectories = trajectoriesRaw as {
  generated_at: string;
  teams: Record<string, Record<string, Array<{ week: number; adj_off_ppa: number; adj_def_value: number }>>>;
};

const hasGameHistory = gameHistory.year === row.year && gameHistory.teams[row.team];

const sortedGameLog = hasGameHistory
  ? [...gameHistory.teams[row.team]].sort((a, b) => a.week - b.week)
  : [...row.gameLog].sort((a, b) => a.week - b.week);

// trajectories.json nests by team then year (string key) — pull this team-year's series,
// defaulting to an empty array so the chart component's own empty-state handles it.
const teamTrajectory = trajectories.teams[row.team]?.[String(row.year)] ?? [];
---

<Layout title={`${row.team} — Team Page`} seasonLabel={`${row.year} Season`}>
  <a href="/" class="back-link">&larr; Back to rankings</a>

  <div class="team-header">
    <div class="rank-badge">#{ranks?.overallRank ?? '—'}</div>
    <div>
      <h1>{row.team}</h1>
      <p class="subtitle">{row.conference} · Conf Rank #{ranks?.confRank ?? '—'} · {row.year} Season</p>
    </div>
  </div>

  <div class="stat-row">
    <div class="stat">
      <span class="label">Net Rating</span>
      <span class="value">{formatRating(row.netRating)}</span>
      <span class="rank-sub">#{ranks?.overallRank ?? '—'} of {totalTeams}</span>
    </div>
    <div class="stat">
      <span class="label">Off Rating</span>
      <span class="value">{row.offRating.toFixed(1)}</span>
    </div>
    <div class="stat">
      <span class="label">Def Rating</span>
      <span class="value">{row.defRating.toFixed(1)}</span>
    </div>
  </div>

  <TeamTrajectoryChart
    client:load
    team={row.team}
    trajectory={teamTrajectory}
    gameLog={row.gameLog}
    gameHistory={hasGameHistory ? gameHistory.teams[row.team] : undefined}
  />

  <h2 class="section-title">Schedule &amp; Results</h2>
  <table class="game-log-table">
    <thead>
      <tr>
        <th>Week</th>
        <th>Opponent</th>
        <th>Result</th>
        <th class="num">Margin</th>
        {hasGameHistory && <th class="num">Predicted</th>}
        {hasGameHistory && <th class="num">Beat Exp.</th>}
      </tr>
    </thead>
    <tbody>
      {sortedGameLog.map((g: any) => {
        const margin = hasGameHistory ? g.actual_margin : g.margin;
        const win = hasGameHistory ? g.result === 'W' : g.win;
        const opponentLabel = hasGameHistory
          ? `${g.location === 'Home' ? 'vs' : '@'} ${g.opponent}`
          : g.opponent;

        const maxMargin = Math.max(1, ...sortedGameLog.map((x: any) =>
          Math.abs(hasGameHistory ? x.actual_margin : x.margin)
        ));
        const intensity = Math.min(1, Math.abs(margin) / maxMargin);
        const bg = win
          ? `rgba(34, 197, 94, ${0.12 + intensity * 0.28})`
          : `rgba(239, 68, 68, ${0.12 + intensity * 0.28})`;

        return (
          <tr style={{ backgroundColor: bg }}>
            <td>{g.week}</td>
            <td>{opponentLabel}</td>
            <td class={win ? 'win' : 'loss'}>{win ? 'W' : 'L'}</td>
            <td class="num">{margin > 0 ? '+' : ''}{margin}</td>
            {hasGameHistory && (
              <td class="num">{g.predicted_margin > 0 ? '+' : ''}{g.predicted_margin}</td>
            )}
            {hasGameHistory && (
              <td class="num" style={{ color: g.beat_expectation_by >= 0 ? '#4ade80' : '#f87171' }}>
                {g.beat_expectation_by > 0 ? '+' : ''}{g.beat_expectation_by}
              </td>
            )}
          </tr>
        );
      })}
    </tbody>
  </table>
</Layout>