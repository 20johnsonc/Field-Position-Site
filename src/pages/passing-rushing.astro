---
// src/pages/passing-rushing.astro
// League-wide, sortable passing/rushing stats table. Reads public/data/passing-rushing/
// (written by the "Passing & Rushing Breakdown Export" notebook cell) the same way
// index.astro reads rankings/matchups: plain fs + JSON, no content collections.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Layout from '../layouts/Layout.astro';
import { buildRows, sortRows, tableHtml, tableFields, views, PRIMARY_FIELD } from '../lib/prTable';

const PUBLIC_DATA = join(process.cwd(), 'public', 'data');
function loadJson(relPath: string, fallback: unknown = {}) {
  try {
    return JSON.parse(readFileSync(join(PUBLIC_DATA, relPath), 'utf-8'));
  } catch {
    return fallback;
  }
}

const index = loadJson('passing-rushing/index.json', { years: [], default_year: null }) as
  { years: number[]; default_year: number | null };
const years = [...index.years].sort((a, b) => b - a);
const defaultYear = years.includes(index.default_year ?? -1) ? (index.default_year as number) : years[0];

const seedPayload = defaultYear != null
  ? loadJson(`passing-rushing/${defaultYear}.json`, { year: defaultYear, teams: {} })
  : { year: defaultYear, teams: {} };

// Check all possible key names your notebook/JSON might be using:
const lastUpdate = 
  seedPayload.generatedAtStr ?? 
  seedPayload.generated_at ?? 
  index.generatedAtStr ?? 
  index.generated_at ?? 
  '';

// Debug check (this will print in your terminal during dev mode / astro build):
console.log('passing-rushing lastUpdate:', {
  seedPayload_generatedAtStr: seedPayload.generatedAtStr,
  seedPayload_generated_at: seedPayload.generated_at,
  index_generatedAtStr: index.generatedAtStr,
  resolved_lastUpdate: lastUpdate
});

// Same server-render == client-render path the table page uses after a year
// change, so first paint and every re-render produce identical markup.
const kind = 'passing' as const;
const side = 'offense' as const;
const view = 'total';
const rows = sortRows(
  buildRows(seedPayload.teams, kind, side, view),
  PRIMARY_FIELD[kind],
  tableFields(kind),
  false,
);
const slugify = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
const teamHref = (t: string) => `/teams/${defaultYear}/${slugify(t)}/`;
const initialTableHtml = tableHtml({ rows, kind, view, pinned: new Set(), teamHref });

function escapeForScript(json: string) {
  return json.replace(/</g, '\\u003c');
}
---

<Layout title="Passing & Rushing Rankings" seasonLabel={defaultYear ? `${defaultYear} Season` : 'Analytics'} {lastUpdate}>
  <a href="/" class="back-link">&larr; Return</a>

  <h1 class="page-title">Passing &amp; Rushing Rankings</h1>
  <p class="page-subtitle">
    Raw team production by target zone and rush direction. Not opponent-adjusted &mdash;
    a team's schedule strength isn't reflected here.
  </p>

  <div id="pr-table-root" class="pt-wrapper" data-base="">

    <div class="pt-controls">
      <div class="pt-row">
        <div class="segmented-control">
          <button type="button" id="pt-mode-table" class="toggle-btn active">Table</button>
          <button type="button" id="pt-mode-scatter" class="toggle-btn">Scatter</button>
        </div>
        <div class="segmented-control">
          <button type="button" id="pt-offense" class="toggle-btn active">Offense</button>
          <button type="button" id="pt-defense" class="toggle-btn">Defense Allowed</button>
        </div>
        <button id="scatter-theme-btn" style="display: none;" class="scatter-theme-btn">
          <span class="theme-icon"></span> Theme: Dark
        </button>
      </div>

      <div class="pt-row" id="pt-table-controls">
        <div class="segmented-control">
          <button type="button" id="pt-tab-passing" class="toggle-btn active">Passing</button>
          <button type="button" id="pt-tab-rushing" class="toggle-btn">Rushing</button>
        </div>
        <label class="pt-field">
          <span>View</span>
          <select id="pt-view" class="pt-select">
            {views(kind).map((v) => <option value={v.key}>{v.label}</option>)}
          </select>
        </label>
      </div>

      <div class="pt-row pt-axis-row" id="pt-axis-row" hidden>
        <div class="pt-axis-group">
          <span class="pt-axis-title">X axis</span>
          <select id="pt-x-kind" class="pt-select pt-select-sm">
            <option value="passing">Passing</option>
            <option value="rushing">Rushing</option>
          </select>
          <select id="pt-x-view" class="pt-select pt-select-sm"></select>
          <select id="pt-x-field" class="pt-select pt-select-sm"></select>
        </div>
        <div class="pt-axis-group">
          <span class="pt-axis-title">Y axis</span>
          <select id="pt-y-kind" class="pt-select pt-select-sm">
            <option value="passing">Passing</option>
            <option value="rushing" selected>Rushing</option>
          </select>
          <select id="pt-y-view" class="pt-select pt-select-sm"></select>
          <select id="pt-y-field" class="pt-select pt-select-sm"></select>
        </div>
      </div>

      <div class="pt-row">
        <label class="pt-field">
          <span>Year</span>
          <select id="pt-year" class="pt-select">
            {years.map((y) => <option value={y} selected={y === defaultYear}>{y}</option>)}
          </select>
        </label>
        <label class="pt-field">
          <span>Conference</span>
          <select id="pt-conf" class="pt-select"><option value="ALL">All Conferences</option></select>
        </label>
        <label class="pt-field">
          <span>Min. volume</span>
          <input id="pt-min" class="pt-input" type="number" min="0" placeholder="0" />
        </label>
        <label class="pt-field pt-search">
          <span>Search</span>
          <input id="pt-search" class="pt-input" type="text" placeholder="Team name" />
        </label>
      </div>
    </div>

    <p class="pt-hint" id="pt-hint">
      Table: check a row to pin it, click a header to sort. Scatter: dot size reflects sample
      size, dashed lines mark each axis's average, click a dot to open that team's page.
    </p>

    <div class="pt-table-scroll" id="pt-table-wrap">
      <table id="pt-table" set:html={initialTableHtml}></table>
    </div>
    <p id="pt-empty" class="pt-empty">No teams match these filters.</p>

    <div class="pt-scatter-wrap" id="pt-scatter-wrap" hidden>
      <div id="pt-scatter" class="pt-scatter"></div>
    </div>
    <div id="pr-scatter-tooltip" class="pt-tooltip" hidden></div>
  </div>

  <script id="pt-seed-year" type="application/json" set:html={escapeForScript(JSON.stringify(seedPayload))} />
</Layout>

<script>
  import { initPrTable } from '../scripts/prTableClient';
  // This inline script only ever executes once (the first time this page is
  // reached), whether that's a hard load or a soft navigation via Astro's
  // ClientRouter -- so the direct call here covers first load, and the
  // astro:page-load listener is what makes every later re-visit to this page
  // (via soft nav) re-run initPrTable() too. initPrTable() itself tears down
  // its own previous listeners on every call, so calling it twice back-to-back
  // on first load (direct call + the event firing for the same load) is safe.
  initPrTable();
  document.addEventListener('astro:page-load', initPrTable);
</script>

<style>
  .page-title {
    font-size: 1.75rem;
    font-weight: 800;
    margin: 1.5rem 0 0.25rem;
    color: var(--text);
  }

  .page-subtitle {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: 0 0 1.5rem;
    max-width: 46rem;
  }

  .pt-wrapper {
    color: var(--text);
    font-family: inherit;
  }

  /* =========================================
    Controls
    ========================================= */

  .pt-controls {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    background: var(--card-bg);
    backdrop-filter: blur(12px);
    border: 1px solid var(--card-border);
    border-radius: 0.875rem;
    padding: 1rem 1.25rem;
    margin-bottom: 0.75rem;
  }

  .pt-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    align-items: flex-end;
  }

  .pt-row[hidden] {
    display: none;
  }

  /* =========================================
    Segmented Controls
    ========================================= */

  .segmented-control {
    background: var(--input-bg);
    padding: 0.25rem;
    border-radius: 0.75rem;
    display: flex;
    gap: 0.25rem;
    border: 1px solid var(--card-border);
  }

  .toggle-btn {
    padding: 0.375rem 1rem;
    font-size: 0.75rem;
    font-weight: 700;
    border-radius: 0.5rem;
    color: var(--text-muted);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .toggle-btn.active {
    background: var(--accent-primary);
    color: var(--bg);
  }

  /* Rushing / Defense use the success accent */
  #pt-tab-rushing.active,
  #pt-defense.active {
    background: var(--accent-success);
    color: var(--bg);
  }

  .toggle-btn:not(.active):hover {
    color: var(--text);
    background: color-mix(
      in srgb,
      var(--text) 5%,
      transparent
    );
  }

  /* =========================================
    Fields / Inputs
    ========================================= */

  .pt-field {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: 0.6875rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .pt-search {
    flex: 1;
    min-width: 10rem;
  }

  .pt-select,
  .pt-input {
    background: var(--input-bg);
    color: var(--text);
    border: 1px solid var(--card-border);
    padding: 0.4rem 0.6rem;
    border-radius: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    outline: none;
    transition: all 0.2s ease;
  }

  .pt-select:focus,
  .pt-input:focus {
    border-color: var(--accent-primary);
    box-shadow: 0 0 0 2px var(--glow-primary);
  }

  .pt-input[type="number"] {
    width: 5.5rem;
  }

  .pt-hint {
    font-size: 0.75rem;
    color: var(--text-dim);
    margin: 0 0 0.75rem;
  }

  /* =========================================
    Table
    ========================================= */

  .pt-table-scroll {
    overflow-x: auto;
    border: 1px solid var(--card-border);
    border-radius: 0.875rem;
    background: var(--card-bg);
    backdrop-filter: blur(12px);
  }

  #pt-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8125rem;
    background: transparent;
  }

  #pt-table :global(th),
  #pt-table :global(td) {
    padding: 0.55rem 0.8rem;
    text-align: left;
    white-space: nowrap;
  }

  #pt-table :global(thead th) {
    background: color-mix(
      in srgb,
      var(--text) 2%,
      transparent
    );
    color: var(--text-muted);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-bottom: 1px solid var(--card-border);
    position: sticky;
    top: 0;
    z-index: 1;
  }

  #pt-table :global(th.sortable) {
    cursor: pointer;
    user-select: none;
  }

  #pt-table :global(th.sortable:hover) {
    color: var(--accent-primary);
  }

  #pt-table :global(th.sortable.active) {
    color: var(--accent-primary);
  }

  #pt-table :global(th.sortable.active::after) {
    content: ' \25BC';
    font-size: 0.6em;
  }

  #pt-table :global(th.sortable.active.asc::after) {
    content: ' \25B2';
  }

  #pt-table :global(th.num),
  #pt-table :global(td.num) {
    text-align: right;
  }

  #pt-table :global(td) {
    border-bottom: 1px solid var(--card-border);
    color: var(--text);
  }

  #pt-table :global(tbody tr) {
    transition: background-color 0.2s ease;
  }

  #pt-table :global(tbody tr:hover) {
    background: color-mix(
      in srgb,
      var(--accent-primary) 4%,
      transparent
    );
  }

  #pt-table :global(tr.pinned) {
    background: color-mix(
      in srgb,
      var(--accent-primary) 8%,
      transparent
    );
  }

  #pt-table :global(tr.pinned:hover) {
    background: color-mix(
      in srgb,
      var(--accent-primary) 14%,
      transparent
    );
  }

  #pt-table :global(.team-cell a) {
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }

  #pt-table :global(.team-cell a:hover) {
    color: var(--accent-primary);
    text-decoration: underline;
  }

  #pt-table :global(.pin-col) {
    width: 2rem;
    text-align: center;
  }

  #pt-table :global(.rank-col) {
    width: 2.25rem;
    color: var(--text-dim);
    font-variant-numeric: tabular-nums;
  }

  #pt-table :global(tr.dimmed) {
    opacity: 0.3;
    transition: opacity 0.2s ease;
  }

  #pt-table :global(tr.dimmed:hover) {
    opacity: 1;
  }

  .pt-empty {
    display: none;
    text-align: center;
    padding: 2rem;
    color: var(--text-dim);
    font-size: 0.875rem;
  }

  .pt-empty.visible {
    display: block;
  }

  /* =========================================
    Axis Controls
    ========================================= */

  .pt-axis-row {
    align-items: center;
  }

  .pt-axis-group {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .pt-axis-title {
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-right: 0.15rem;
  }

  .pt-select-sm {
    padding: 0.32rem 0.5rem;
    font-size: 0.75rem;
  }

  /* =========================================
    Scatter Chart
    Default theme follows global.css
    ========================================= */

  .pt-scatter-wrap {
    border: 1px solid var(--card-border);
    border-radius: 0.875rem;
    background: var(--card-bg);
    backdrop-filter: blur(12px);
    padding: 0.75rem;
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease;
  }

  .pt-scatter {
    min-height: 220px;
  }

  .pt-scatter :global(svg.scatter-svg) {
    width: 100%;
    aspect-ratio: 760 / 460;
    height: auto;
    display: block;
    min-height: 220px;
  }

  .pt-scatter :global(.grid) {
    stroke: var(--card-border);
    stroke-width: 1;
  }

  .pt-scatter :global(.axis) {
    stroke: var(--text-dim);
    stroke-width: 1.25;
  }

  .pt-scatter :global(.mean-line) {
    stroke: var(--text-dim);
    stroke-width: 1;
    stroke-dasharray: 4 4;
    opacity: 0.8;
  }

  .pt-scatter :global(.tick) {
    fill: var(--text-muted);
    font-size: 10px;
  }

  .pt-scatter :global(.axis-label) {
    fill: var(--text-muted);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .pt-scatter :global(.dot) {
    fill-opacity: 0.75;
    stroke: var(--input-bg);
    stroke-width: 1;
    cursor: pointer;
    transition:
      opacity 0.15s ease,
      fill-opacity 0.15s ease,
      stroke-width 0.15s ease;
  }

  .pt-scatter :global(.dot:hover),
  .pt-scatter :global(.dot:focus) {
    fill-opacity: 1;
    stroke: var(--text);
    stroke-width: 1.5;
    outline: none;
    paint-order: stroke;
  }

  .pt-scatter :global(.dot.pinned) {
    stroke: var(--accent-danger);
    stroke-width: 2;
  }

  .pt-scatter :global(.dot.dimmed) {
    opacity: 0.15;
  }

  .pt-scatter :global(.dot.match) {
    opacity: 1;
    stroke: var(--text);
    stroke-width: 1.5;
  }

  .pt-scatter :global(.dot.match:hover),
  .pt-scatter :global(.dot.match:focus) {
    stroke-width: 2;
  }

  .pt-scatter :global(.scatter-empty) {
    text-align: center;
    color: var(--text-dim);
    font-size: 0.875rem;
    padding: 2rem;
    margin: 0;
  }

  /* =========================================
    Independent Scatter Light Theme
    Preserves .theme-light JS behavior
    ========================================= */

  :global(.pt-scatter-wrap.theme-light) {
    border-color: var(--card-border) !important;
    background: var(--card-bg) !important;
  }

  :global(.pt-scatter-wrap.theme-light) :global(.grid) {
    stroke: var(--card-border) !important;
  }

  :global(.pt-scatter-wrap.theme-light) :global(.axis) {
    stroke: var(--text-dim) !important;
  }

  :global(.pt-scatter-wrap.theme-light) :global(.mean-line) {
    stroke: var(--text-dim) !important;
  }

  :global(.pt-scatter-wrap.theme-light) :global(.tick) {
    fill: var(--text-muted) !important;
  }

  :global(.pt-scatter-wrap.theme-light) :global(.axis-label) {
    fill: var(--text-muted) !important;
  }

  /* When chart is explicitly light, keep dots visible */
  :global(.pt-scatter-wrap.theme-light) :global(.dot) {
    fill-opacity: 0.85;
    stroke: var(--text) !important;
  }

  :global(.pt-scatter-wrap.theme-light) :global(.dot:hover),
  :global(.pt-scatter-wrap.theme-light) :global(.dot:focus) {
    stroke: var(--text) !important;
    stroke-width: 2px !important;
  }

  :global(.pt-scatter-wrap.theme-light) :global(.dot.pinned) {
    stroke: var(--accent-danger) !important;
  }

  :global(.pt-scatter-wrap.theme-light) :global(.dot.match) {
    stroke: var(--text) !important;
  }

  :global(.pt-scatter-wrap.theme-light) :global(.dot.dimmed) {
    opacity: 0.3;
  }

  /* =========================================
    Tooltip
    ========================================= */

  .pt-tooltip[hidden] {
    display: none;
  }

  .pt-tooltip {
    position: fixed;
    z-index: 40;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    background: var(--card-bg);
    backdrop-filter: blur(12px);
    border: 1px solid var(--card-border);
    border-radius: 0.5rem;
    padding: 0.5rem 0.65rem;
    font-size: 0.75rem;
    color: var(--text);
    box-shadow: 0 10px 20px -6px rgba(0, 0, 0, 0.6);
    pointer-events: none;
    max-width: 14rem;
  }

  .pt-tooltip strong {
    font-size: 0.8125rem;
    color: var(--text);
  }

  .pt-tooltip .tt-conf {
    color: var(--text-muted);
    font-size: 0.6875rem;
    margin-bottom: 0.15rem;
  }

  /* =========================================
    Scatter Theme Button
    ========================================= */

  #scatter-theme-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--input-bg);
    border: 1px solid var(--card-border);
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.375rem 1rem;
    border-radius: 0.75rem;
    cursor: pointer;
    margin-left: auto;
    transition: all 0.2s ease;
  }

  #scatter-theme-btn:hover {
    color: var(--text);
    background: color-mix(
      in srgb,
      var(--text) 5%,
      var(--input-bg)
    );
    border-color: color-mix(
      in srgb,
      var(--text) 15%,
      var(--card-border)
    );
  }

  #scatter-theme-btn.is-light {
    background: var(--input-bg);
    color: var(--text);
    border-color: var(--card-border);
  }

  /* =========================================
    Global Light Mode Adjustments
    ========================================= */

  [data-theme="light"] .pt-controls,
  [data-theme="light"] .pt-scatter-wrap,
  [data-theme="light"] .pt-table-scroll {
    background: rgba(255, 255, 255, 0.85);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }

  [data-theme="light"] .segmented-control {
    background: rgba(0, 0, 0, 0.03);
  }

  [data-theme="light"] #pt-table :global(thead th) {
    background: rgba(0, 0, 0, 0.02);
  }

  [data-theme="light"] .pt-tooltip {
    background: #ffffff;
    color: var(--text);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
  }
</style