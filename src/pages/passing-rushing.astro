---
// src/pages/passing-rushing.astro
// League-wide, sortable passing/rushing stats table. Reads public/data/passing-rushing/
// (written by the "Passing & Rushing Breakdown Export" notebook cell) the same way
// index.astro reads rankings/matchups: plain fs + JSON, no content collections.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Layout from '../layouts/Layout.astro';
import { buildRows, sortRows, tableHtml, tableFields, views, PRIMARY_FIELD } from '../lib/prTable';

const PUBLIC_DATA = join(process.cwd(), 'public', 'data');
function loadJson(relPath: string, fallback: unknown = {}) {
  try {
    return JSON.parse(readFileSync(join(PUBLIC_DATA, relPath), 'utf-8'));
  } catch {
    return fallback;
  }
}

const index = loadJson('passing-rushing/index.json', { years: [], default_year: null }) as
  { years: number[]; default_year: number | null };
const years = [...index.years].sort((a, b) => b - a);
const defaultYear = years.includes(index.default_year ?? -1) ? (index.default_year as number) : years[0];

const seedPayload = defaultYear != null
  ? loadJson(`passing-rushing/${defaultYear}.json`, { year: defaultYear, teams: {} })
  : { year: defaultYear, teams: {} };

// Same server-render == client-render path the table page uses after a year
// change, so first paint and every re-render produce identical markup.
const kind = 'passing' as const;
const side = 'offense' as const;
const view = 'total';
const rows = sortRows(
  buildRows(seedPayload.teams, kind, side, view),
  PRIMARY_FIELD[kind],
  tableFields(kind),
  false,
);
const slugify = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
const teamHref = (t: string) => `/teams/${defaultYear}/${slugify(t)}/`;
const initialTableHtml = tableHtml({ rows, kind, view, pinned: new Set(), teamHref });

function escapeForScript(json: string) {
  return json.replace(/</g, '\\u003c');
}
---

<Layout title="Passing & Rushing Rankings" seasonLabel={defaultYear ? `${defaultYear} Season` : 'Analytics'}>
  <a href="/" class="back-link">&larr; Return</a>

  <h1 class="page-title">Passing &amp; Rushing Stats</h1>
  <p class="page-subtitle">
    Raw team production sortable by area of the field. Not opponent-adjusted &mdash;
    a team's schedule strength is not reflected here.
  </p>

  <div id="pr-table-root" class="pt-wrapper" data-base="">

    <div class="pt-controls">
      <div class="pt-row">
        <div class="segmented-control">
          <button type="button" id="pt-tab-passing" class="toggle-btn active">Passing</button>
          <button type="button" id="pt-tab-rushing" class="toggle-btn">Rushing</button>
        </div>
        <div class="segmented-control">
          <button type="button" id="pt-offense" class="toggle-btn active">Offense</button>
          <button type="button" id="pt-defense" class="toggle-btn">Defense Allowed</button>
        </div>
      </div>

      <div class="pt-row">
        <label class="pt-field">
          <span>Year</span>
          <select id="pt-year" class="pt-select">
            {years.map((y) => <option value={y} selected={y === defaultYear}>{y}</option>)}
          </select>
        </label>
        <label class="pt-field">
          <span>Zone</span>
          <select id="pt-view" class="pt-select">
            {views(kind).map((v) => <option value={v.key}>{v.label}</option>)}
          </select>
        </label>
        <label class="pt-field">
          <span>Conference</span>
          <select id="pt-conf" class="pt-select"><option value="ALL">All Conferences</option></select>
        </label>
        <label class="pt-field">
          <span>Min. volume</span>
          <input id="pt-min" class="pt-input" type="number" min="0" placeholder="0" />
        </label>
        <label class="pt-field pt-search">
          <span>Search</span>
          <input id="pt-search" class="pt-input" type="text" placeholder="Team name" />
        </label>
      </div>
    </div>

    <p class="pt-hint">Check a row to pin it to the top. Click a column header to sort.</p>

    <div class="pt-table-scroll">
      <table id="pt-table" set:html={initialTableHtml} />
    </div>
    <p id="pt-empty" class="pt-empty">No teams match these filters.</p>
  </div>

  <script id="pt-seed-year" type="application/json" set:html={escapeForScript(JSON.stringify(seedPayload))} />
</Layout>

<script>
  import { initPrTable } from '../scripts/prTableClient';
  initPrTable();
</script>

<style>
  .page-title { font-size: 1.75rem; font-weight: 800; margin: 0 0 0.25rem; color: #f1f5f9; }
  .page-subtitle { font-size: 0.875rem; color: #94a3b8; margin: 0 0 1.5rem; max-width: 46rem; }

  .pt-wrapper { color: #f1f5f9; font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }

  .pt-controls {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 0.875rem;
    padding: 1rem 1.25rem;
    margin-bottom: 0.75rem;
  }
  .pt-row { display: flex; flex-wrap: wrap; gap: 0.75rem 1rem; align-items: flex-end; }

  .segmented-control {
    background: #0b1220;
    padding: 0.25rem;
    border-radius: 0.75rem;
    display: flex;
    gap: 0.25rem;
    border: 1px solid #1e293b;
  }
  .toggle-btn {
    padding: 0.375rem 1rem;
    font-size: 0.75rem;
    font-weight: 700;
    border-radius: 0.5rem;
    color: #94a3b8;
    background: transparent;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .toggle-btn.active { background: #2563eb; color: #ffffff; }
  #pt-tab-rushing.active, #pt-defense.active { background: #059669; }
  .toggle-btn:not(.active):hover { color: #ffffff; background: #1e293b; }

  .pt-field { display: flex; flex-direction: column; gap: 0.3rem; font-size: 0.6875rem; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.04em; }
  .pt-search { flex: 1; min-width: 10rem; }
  .pt-select, .pt-input {
    background: #0b1220;
    color: #f8fafc;
    border: 1px solid #334155;
    padding: 0.4rem 0.6rem;
    border-radius: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    outline: none;
  }
  .pt-select:focus, .pt-input:focus { border-color: #3b82f6; }
  .pt-input[type="number"] { width: 5.5rem; }

  .pt-hint { font-size: 0.75rem; color: #64748b; margin: 0 0 0.75rem; }

  .pt-table-scroll { overflow-x: auto; border: 1px solid #1e293b; border-radius: 0.875rem; }

  #pt-table { width: 100%; border-collapse: collapse; font-size: 0.8125rem; background: #030712; }
  #pt-table :global(th), #pt-table :global(td) { padding: 0.55rem 0.8rem; text-align: left; white-space: nowrap; }
  #pt-table :global(thead th) {
    background: #0f172a;
    color: #94a3b8;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-bottom: 1px solid #1e293b;
    position: sticky;
    top: 0;
  }
  #pt-table :global(th.sortable) { cursor: pointer; user-select: none; }
  #pt-table :global(th.sortable:hover) { color: #ffffff; }
  #pt-table :global(th.sortable.active) { color: #60a5fa; }
  #pt-table :global(th.sortable.active::after) { content: ' \25BC'; font-size: 0.6em; }
  #pt-table :global(th.sortable.active.asc::after) { content: ' \25B2'; }
  #pt-table :global(th.num), #pt-table :global(td.num) { text-align: right; }
  #pt-table :global(td) { border-bottom: 1px solid #1e293b; color: #e2e8f0; }
  #pt-table :global(tbody tr:hover) { background: #0b1220; }
  #pt-table :global(tr.pinned) { background: rgba(59, 130, 246, 0.08); }
  #pt-table :global(tr.pinned:hover) { background: rgba(59, 130, 246, 0.14); }
  #pt-table :global(.team-cell a) { color: #f1f5f9; font-weight: 600; text-decoration: none; }
  #pt-table :global(.team-cell a:hover) { color: #60a5fa; text-decoration: underline; }
  #pt-table :global(.pin-col) { width: 2rem; text-align: center; }
  #pt-table :global(.rk) { color: #94a3b8; }
  #pt-table :global(.rk small) { opacity: 0.7; }

  .pt-empty { display: none; text-align: center; padding: 2rem; color: #64748b; font-size: 0.875rem; }
  .pt-empty.visible { display: block; }
</style>