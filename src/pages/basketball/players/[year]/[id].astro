---
import Layout from '../../../../layouts/Layout.astro';
import SportTabs from '../../../../components/SportTabs.astro';
import PlayerDashboard from '../../../../components/PlayerDashboard';
import fs from 'node:fs';
import path from 'node:path';

export const prerender = false;

const { year, id } = Astro.params;
const y = Number(year);

// BULLETPROOF FIX: Read directly from the file system
let playersDoc, rankingsDoc;
try {
  const playersPath = path.join(process.cwd(), 'public', 'data', 'basketball', `${y}`, 'players.json');
  const rankingsPath = path.join(process.cwd(), 'public', 'data', 'basketball', `${y}`, 'rankings.json');
  
  playersDoc = JSON.parse(fs.readFileSync(playersPath, 'utf-8'));
  rankingsDoc = JSON.parse(fs.readFileSync(rankingsPath, 'utf-8'));
} catch (e) {
  throw new Error(`Missing data for ${y}. Make sure players.json and rankings.json exist.`);
}

const player = playersDoc.players.find((p: any) => String(p.player_id || p.id) === id);
if (!player) return Astro.redirect('/basketball/players/');

const teamStats = rankingsDoc.teams.find((t: any) => t.team === player.team) || {};

// Team Branding
const pColor = teamStats.primaryColor || 'var(--accent-primary)';
const sColor = teamStats.secondaryColor || 'var(--accent-info)';
const teamGradient = `linear-gradient(135deg, ${pColor}, ${sColor})`;

// Fetch player-index for the year selector
let playerIndexRaw = null;
try {
  const indexPath = path.join(process.cwd(), 'public', 'data', 'basketball', 'player-index.json');
  playerIndexRaw = JSON.parse(fs.readFileSync(indexPath, 'utf-8'));
} catch(e) {}

const entry = playerIndexRaw?.[id];
const validYears: number[] = entry?.teams
  ? [...new Set(entry.teams.map((t: any) => Number(t.year)))].sort((a, b) => b - a)
  : [y];

// Helpers
const seasonLabel = `${y - 1}-${String(y).slice(-2)}`;
const fmt = (v: number | null, d = 1) => v == null ? '—' : v.toFixed(d);
const slugify = (name: string | null | undefined) => (name || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---

<Layout title={`${player.name} - ${seasonLabel}`} seasonLabel={seasonLabel}>
  <div class="container">
    
    <div style="display: flex; align-items: center; flex-wrap: wrap; gap: 24px; margin-bottom: 24px;">
      <SportTabs />
      <div class="tabs" style="margin-bottom: 0;">
        <a href="/basketball/" class="tab-btn" style="text-decoration: none;">Team Rankings</a>
        <a href="/basketball/players/" class="tab-btn" style="text-decoration: none;">Player Leaderboard</a>
        <a href="/basketball/game-preview/" class="tab-btn" style="text-decoration: none;">Game Preview</a>
      </div>

      {validYears.length > 1 && (
        <div class="controls" style="margin-bottom: 0; margin-left: auto; padding: 0; background: transparent; border: none; box-shadow: none;">
          <select id="playerYearSelect" data-player-id={player.player_id || player.id} aria-label="Switch Year" style="padding: 8px 12px; border-radius: 6px; border: 1px solid var(--card-border); background: var(--surface-2); color: var(--text); font-size: 0.9rem; font-weight: 600; outline: none; cursor: pointer;">
            {validYears.map(yr => (
              <option value={yr} selected={yr === y ? true : undefined}>
                {yr - 1}-{String(yr).slice(-2)} Season
              </option>
            ))}
          </select>
        </div>
      )}
    </div>

    {/* ─────────── Hero ─────────── */}
    <div class="card hero-card" style="margin-bottom: 24px; padding: 0; overflow: hidden; position: relative;">
      <div style={`position: absolute; top: 0; left: 0; right: 0; height: 4px; background: ${teamGradient};`}></div>

      <div style="padding: 28px 28px 24px 28px;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 16px;">
          
          <div>
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px;">
              {teamStats.logo && <img src={teamStats.logo} alt={teamStats.team} class="logo-light" style="width: 36px; height: 36px; object-fit: contain;" />}
              {teamStats.logo_dark && <img src={teamStats.logo_dark} alt={teamStats.team} class="logo-dark" style="width: 36px; height: 36px; object-fit: contain; display: none;" />}
              
              <h1 style="font-size: 2.5rem; margin: 0; letter-spacing: -0.02em;">
                {player.name}
                {player.jersey && <span style="font-size: 1.5rem; color: var(--text-muted); font-weight: 500; margin-left: 8px;">#{player.jersey}</span>}
              </h1>
            </div>
            
            <p style="color: var(--text-muted); font-size: 1rem; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin: 0;">
              <a href={`/basketball/teams/${y}/${slugify(player.team)}/`} style={`color: ${pColor}; text-decoration: none; font-weight: 800;`}>
                {player.team}
              </a> 
              <span style="font-size: 0.85rem;">{teamStats.mascot || player.conference}</span>
              {player.class && <> · <span style="font-weight: 600;">{player.class}</span></>}
              {player.position && <> · <span class="pill" style="padding: 2px 8px; font-size: 0.8rem; font-weight: 700; margin: 0;">{player.position}</span></>}
              {player.height && <> · {Math.floor(player.height / 12)}'{player.height % 12}"</>}
              {player.weight && <> · {player.weight} lbs</>}
            </p>
          </div>
          
          <div style="display: flex; gap: 32px; text-align: right;">
            <div>
              <div style="font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; letter-spacing: 0.06em; margin-bottom: 4px;">Rank</div>
              <div style="font-size: 1.4rem; font-weight: 900; color: var(--text);">#{player.rank}</div>
            </div>
            <div>
              <div style="font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; letter-spacing: 0.06em; margin-bottom: 4px;">Net RAPM</div>
              <div style={`font-size: 1.4rem; font-weight: 900; color: ${player.net_rating >= 5 ? 'var(--accent-success, #16a34a)' : player.net_rating <= 0 ? 'var(--accent-danger, #dc2626)' : 'var(--text)'};`}>
                {player.net_rating > 0 ? '+' : ''}{fmt(player.net_rating)}
              </div>
            </div>
            <div>
              <div style="font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; letter-spacing: 0.06em; margin-bottom: 4px;">
                {playersDoc.projected ? 'Proj. MPG' : 'MPG'}
              </div>
              <div style="font-size: 1.4rem; font-weight: 900; color: var(--text);">
                {player.min_pg ? player.min_pg.toFixed(1) : fmt(player.minutes_share * 40)}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <PlayerDashboard player={player} year={y} client:visible />

    <div id="gameLogContainer" style="display: none; margin-top: 32px;">
      <h2 class="section-title">Game Log</h2>
      <div class="table-container">
        <table class="rank-table compact-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Opponent</th>
              <th class="num">MIN</th>
              <th class="num">PTS</th>
              <th class="num">REB</th>
              <th class="num">AST</th>
              <th class="num">STL</th>
              <th class="num">BLK</th>
              <th class="num">TO</th>
            </tr>
          </thead>
          <tbody id="gameLogBody"></tbody>
        </table>
      </div>
    </div>
    <div id="gameLogLoading" style="color: var(--text-muted); padding: 20px;">Loading game log...</div>

  </div>
</Layout>

<script define:vars={{ playerId: String(player.player_id || player.id), year: y, isProjected: playersDoc.projected, team: player.team }}>
  const yearSelect = document.getElementById('playerYearSelect');
  if (yearSelect) {
    yearSelect.addEventListener('change', (e) => {
      const newYear = e.target.value;
      const pid = yearSelect.dataset.playerId;
      window.location.href = `/basketball/players/${newYear}/${pid}/`;
    });
  }

  const loadingEl = document.getElementById('gameLogLoading');
  const containerEl = document.getElementById('gameLogContainer');
  const bodyEl = document.getElementById('gameLogBody');
  
  if (isProjected) {
    loadingEl.style.display = 'none';
  } else {
    (async () => {
      try {
        const slugify = (name) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
        const res = await fetch(`/data/basketball/${year}/game_logs/${slugify(team)}.json`);
        if (!res.ok) throw new Error('No game logs found');

        const data = await res.json();
        const logs = data[playerId];

        if (logs && logs.length > 0) {
          bodyEl.innerHTML = logs.map(g => `
            <tr>
              <td>${new Date(g.start_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' })}</td>
              <td>
                ${g.is_home ? 'vs' : '@'} 
                <a href="/basketball/teams/${year}/${slugify(g.opponent)}/" class="team-link">
                  ${g.opponent}
                </a>
              </td>
              <td class="num">${g.minutes}</td>
              <td class="num">${g.points}</td>
              <td class="num">${g.rebounds}</td>
              <td class="num">${g.assists}</td>
              <td class="num">${g.steals}</td>
              <td class="num">${g.blocks}</td>
              <td class="num">${g.turnovers}</td>
            </tr>
          `).join('');
          
          loadingEl.style.display = 'none';
          containerEl.style.display = 'block';
        } else {
          loadingEl.textContent = 'No game-by-game data available for this player.';
        }
      } catch (e) {
        loadingEl.textContent = 'No game-by-game data available.';
      }
    })();
  }
</script>

<style is:global>
  .team-link { color: var(--text); text-decoration: none; transition: color 0.2s ease; }
  .team-link:hover { color: var(--accent-primary); text-decoration: underline; }
  
  .hero-card { transition: box-shadow 0.2s ease; }
  .hero-card:hover { box-shadow: 0 6px 24px rgba(0, 0, 0, 0.08); }
  
  .compact-table th { padding: 8px 6px !important; }
  .compact-table td { padding: 6px 6px !important; font-size: 0.85rem; }
  
  .logo-dark { display: none !important; }
  :global(.dark) .logo-light { display: none !important; }
  :global(.dark) .logo-dark { display: block !important; }
</style>