---
import Layout from '../../../../layouts/Layout.astro';
import SportTabs from '../../../../components/SportTabs.astro';
import { listBasketballYears, loadBasketballYear } from '../../../../lib/basketball';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

export function getStaticPaths() {
  const paths = [];
  const allYears = listBasketballYears();
  const teamYearsMap: Record<string, number[]> = {};

  // 1. Find every year each team existed
  for (const year of allYears) {
    const data = loadBasketballYear(year);
    if (!data) continue;
    for (const team of data.rankings.teams) {
      const slug = team.team.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
      if (!teamYearsMap[slug]) teamYearsMap[slug] = [];
      teamYearsMap[slug].push(year);
    }
  }

  // 2. Generate paths, attaching only the valid years for that specific team
  for (const year of allYears) {
    const data = loadBasketballYear(year);
    if (!data) continue;
    for (const team of data.rankings.teams) {
      const slug = team.team.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
      paths.push({
        params: { year: String(year), team: slug },
        props: { 
          actualTeamName: team.team,
          validYears: teamYearsMap[slug].sort((a, b) => b - a) // descending (latest first)
        }
      });
    }
  }
  return paths;
}

const { year, team } = Astro.params;
const { actualTeamName, validYears } = Astro.props;
const y = Number(year);

const data = loadBasketballYear(y);
if (!data) throw new Error(`Missing data for ${year}`);

// Load the schedule
let schedule = [];
try {
  const schedPath = join(process.cwd(), 'public', 'data', 'basketball', String(y), 'schedule.json');
  const allSchedules = JSON.parse(readFileSync(schedPath, 'utf-8'));
  schedule = allSchedules[actualTeamName] || [];
} catch (e) {
  // Ignore if no schedule exists (e.g., 2027 projection)
}

const { rankings, players } = data;
const teamStats = rankings.teams.find((t: any) => t.team === actualTeamName);
const roster = players.players
  .filter((p: any) => p.team === actualTeamName)
  .sort((a: any, b: any) => b.minutes_share - a.minutes_share);

const seasonLabel = `${y - 1}-${String(y).slice(-2)}`;
const stateLabel = rankings.projected ? 'Preseason projection' : 'Final ratings';

const fmt = (v: number | null, d = 1) => v == null ? '—' : v.toFixed(d);
const slugify = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

const teamPlayTypes = roster.reduce((acc: any, p: any) => {
  if (p.play_types) {
    for (const [type, data] of Object.entries(p.play_types)) {
      const d = data as any;
      if (!acc[type]) acc[type] = { freq: 0, pts: 0 };
      acc[type].freq += d.freq_pg || 0; // Using per-game average
      acc[type].pts += (d.ppp || 0) * (d.freq_pg || 0);
    }
  }
  return acc;
}, {});

const sortedPlayTypes = Object.entries(teamPlayTypes)
  .map(([type, data]: [string, any]) => ({
    type,
    freq: data.freq,
    ppp: data.freq > 0 ? data.pts / data.freq : 0
  }))
  .sort((a, b) => b.freq - a.freq)
  .slice(0, 5); // Top 5 play types

const synergyGap = (teamStats?.adj_net || 0) - (teamStats?.direct_net || 0);

let synergyLabel = "Expected Performance";
let synergyColor = "var(--text)";
let synergyDesc = "The team's individual talent matches their actual box score performance.";

if (synergyGap > 3.0) {
    synergyLabel = "Underperforming Talent";
    synergyColor = "var(--accent-danger)";
    synergyDesc = "Individual talent is higher than actual team results. They may be losing close games or struggling with chemistry.";
} else if (synergyGap < -3.0) {
    synergyLabel = "Outperforming Talent";
    synergyColor = "var(--accent-success)";
    synergyDesc = "Team results are better than individual talent suggests. They may be winning close games or have a highly optimized system.";
}
---

<Layout seasonLabel={seasonLabel}>
  <div class="container">
    
    <div style="display: flex; align-items: center; flex-wrap: wrap; gap: 24px; margin-bottom: 24px;">
      <SportTabs />
      
      <div class="tabs" style="margin-bottom: 0;">
        <a href="/basketball/" class="tab-btn" style="text-decoration: none;">Team Rankings</a>
        <a href="/basketball/players/" class="tab-btn" style="text-decoration: none;">Player Leaderboard</a>
        <a href="/basketball/game-preview/" class="tab-btn" style="text-decoration: none;">Game Preview</a>
      </div>

      <!-- Only show the dropdown if the team played in more than one year -->
      {validYears.length > 1 && (
        <div class="controls" style="margin-bottom: 0; margin-left: auto; padding: 0; background: transparent; border: none; box-shadow: none;">
          <select id="teamYearSelect" data-slug={slugify(actualTeamName)} aria-label="Switch Year">
            {validYears.map(yr => (
              <option value={yr} selected={yr === y}>
                {yr - 1}-{String(yr).slice(-2)} Season
              </option>
            ))}
          </select>
        </div>
      )}
    </div>

    <div class="card" style="margin-bottom: 24px; padding: 24px;">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 16px;">
        <div>
          <h1 style="font-size: 2.5rem; margin-bottom: 8px;">{actualTeamName}</h1>
          <p style="color: var(--text-muted); font-size: 1.1rem;">
            {teamStats?.conference} · {stateLabel}
          </p>
        </div>
        
                <div style="display: flex; gap: 24px; text-align: right;">
          <div>
            <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;">Record</div>
            <div style="font-size: 2rem; font-weight: 900; color: var(--text);">
              {teamStats?.wins != null ? `${teamStats.wins}-${teamStats.losses}` : '—'}
            </div>
          </div>
          <div>
            <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;">Rank</div>
            <div style="font-size: 2rem; font-weight: 900; color: var(--accent-primary);">#{teamStats?.rank}</div>
          </div>
          <div>
            <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700;">Net Rating</div>
            <div style="font-size: 2rem; font-weight: 900; color: var(--text);">{fmt(teamStats?.adj_net)}</div>
          </div>
        </div>
      </div>

      <div style="display: flex; gap: 32px; margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--card-border);">
        <div>
          <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; margin-bottom: 4px;">Adj. Offense</div>
          <div style="font-size: 1.5rem; font-weight: 700;">{fmt(teamStats?.adj_off)}</div>
        </div>
        <div>
          <div style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; margin-bottom: 4px;">Adj. Defense</div>
          <div style="font-size: 1.5rem; font-weight: 700;">{fmt(teamStats?.adj_def)}</div>
        </div>
      </div>
    </div>

    <!-- Model Synergy Card -->
    {teamStats?.adj_net != null && teamStats?.direct_net != null && teamStats.direct_net !== 0 && (
      <div class="card" style="margin-bottom: 24px; padding: 24px;">
        
        <!-- Dynamic Title -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 12px;">
          <h2 class="section-title" style="margin: 0;">Model Synergy</h2>
          <div style={`background: var(--surface-2); border: 1px solid ${synergyColor}; color: ${synergyColor}; padding: 6px 12px; border-radius: 20px; font-weight: 800; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em;`}>
            {synergyLabel}
          </div>
        </div>

        <div class="analytics-grid" style="grid-template-columns: 1fr 1fr 1fr;">
          
          <div class="stat-box">
            <span class="stat-label" title="Bottom-up rating calculated from individual player RAPM.">Player RAPM Net</span>
            <span class="stat-comparison">
              <strong>{fmt(teamStats.adj_net)}</strong>
            </span>
          </div>
          
          <div class="stat-box">
            <span class="stat-label" title="Traditional rating calculated purely from team box scores.">Direct Box Net</span>
            <span class="stat-comparison">
              <strong>{fmt(teamStats.direct_net)}</strong>
            </span>
          </div>
          
          <div class="stat-box" style={`border-color: ${synergyColor};`}>
            <span class="stat-label" title="The difference between the two.">Synergy Gap</span>
            <span class="stat-comparison">
              <strong style={`color: ${synergyColor};`}>
                {synergyGap > 0 ? '+' : ''}{fmt(synergyGap)}
              </strong>
            </span>
          </div>
          
        </div>
        
        <!-- Dynamic Description -->
        <div style="margin-top: 16px; font-size: 0.85rem; color: var(--text-muted); text-align: center; border-top: 1px solid var(--card-border); padding-top: 16px;">
          {synergyDesc}
        </div>
      </div>
    )}

    {sortedPlayTypes.length > 0 && (
      <div style="margin-top: 32px;">
        <h2 class="section-title">Offensive Identity (Play Types)</h2>
        <div class="table-container">
          <table class="rank-table">
            <thead>
              <tr>
                <th>Play Type</th>
                <th class="num">Freq / Game</th>
                <th class="num">Points Per Poss (PPP)</th>
              </tr>
            </thead>
            <tbody>
              {sortedPlayTypes.map((pt) => (
                <tr>
                  <td style="text-transform: capitalize;">{pt.type.replace(/_/g, ' ')}</td>
                  <td class="num">{pt.freq.toFixed(1)}</td>
                  <td class="num rating">{pt.ppp.toFixed(2)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}

    <h2 class="section-title">Roster & Player Ratings</h2>
    <div class="table-container">
      <table class="rank-table" id="rosterTable">
        <thead>
          <tr>
            <th class="sortable" data-sort="name">Player <span class="sort-icon">⇕</span></th>
            <th class="sortable" data-sort="position">Pos <span class="sort-icon">⇕</span></th>
            <th class="sortable num" data-sort="offensive_rating">Off RAPM <span class="sort-icon">⇕</span></th>
            <th class="sortable num" data-sort="defensive_rating">Def RAPM <span class="sort-icon">⇕</span></th>
            <th class="sortable num active" data-sort="net_rating">Net <span class="sort-icon">▼</span></th>
            <th class="sortable num" data-sort="minutes_share">{rankings.projected ? 'Proj. MPG ' : 'MPG '} <span class="sort-icon">⇕</span></th>
            <th class="sortable" data-sort="status">Status <span class="sort-icon">⇕</span></th>
          </tr>
        </thead>
        <tbody id="rosterBody"></tbody>
      </table>
    </div>

    <!-- Schedule & Results -->
    {schedule.length > 0 && (
      <div style="margin-top: 32px;">
        <h2 class="section-title">Schedule & Results</h2>
        <div class="table-container">
          <table class="rank-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Opponent</th>
                <th style="text-align: center;">Loc</th>
                <th class="num" style="text-align: center;">Result</th>
                <th class="num" style="text-align: center;">Score</th>
              </tr>
            </thead>
            <tbody>
              {schedule.map((g: any) => {
                const isPlayed = g.team_score !== null && g.opp_score !== null;
                return (
                  <tr style={!isPlayed ? 'opacity: 0.7;' : ''}>
                    <td>{new Date(g.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' })}</td>
                    <td>
                      <a href={`/basketball/teams/${y}/${slugify(g.opponent)}/`} class="team-link">
                        {g.opponent}
                      </a>
                    </td>
                    <td style="text-align: center; color: var(--text-muted);">
                      {g.neutral ? 'N' : (g.is_home ? 'vs' : '@')}
                    </td>
                    <td class="num" style={`font-weight: 800; text-align: center; color: ${g.result === 'W' ? 'var(--accent-success)' : (g.result === 'L' ? 'var(--accent-danger)' : 'var(--text-muted)')}`}>
                      {isPlayed ? g.result : '-'}
                    </td>
                    <td class="num" style="text-align: center;">
                      {isPlayed ? `${g.team_score} - ${g.opp_score}` : 'TBD'}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    )}

  </div>
</Layout>

<script id="roster-data" data-year={y} type="application/json" set:html={JSON.stringify(roster).replace(/</g, '\\u003c')} />

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Handle Year Dropdown navigation
    const yearSelect = document.getElementById('teamYearSelect') as HTMLSelectElement;
    if (yearSelect) {
      yearSelect.addEventListener('change', (e) => {
        const newYear = (e.target as HTMLSelectElement).value;
        const slug = yearSelect.dataset.slug;
        window.location.href = `/basketball/teams/${newYear}/${slug}/`;
      });
    }

    // 2. Handle Table Sorting
    const dataEl = document.getElementById('roster-data');
    const tableBody = document.getElementById('rosterBody');
    if (!dataEl || !tableBody) return;

    const currentYear = dataEl.dataset.year;
    const rosterData = JSON.parse(dataEl.textContent || '[]');
    let currentSortKey = 'net_rating';
    let currentSortDir = -1; 

    const fmt = (v: number | null, d = 1) => v == null ? '—' : v.toFixed(d);
    const getMpg = (p: any) => {
      if (p.min_pg != null && p.min_pg > 0) return p.min_pg.toFixed(1);
      return ((p.minutes_share || 0) * 40).toFixed(1);
    };

    function renderTable() {
      const sorted = [...rosterData].sort((a, b) => {
        let valA = a[currentSortKey];
        let valB = b[currentSortKey];

        if (currentSortKey === 'minutes_share') {
          valA = a.min_pg || (a.minutes_share * 40);
          valB = b.min_pg || (b.minutes_share * 40);
        }

        if (typeof valA === 'string' && typeof valB === 'string') {
          return valA.localeCompare(valB) * currentSortDir;
        }

        if (valA == null) valA = -999;
        if (valB == null) valB = -999;

        return (valA - valB) * currentSortDir;
      });

      tableBody.innerHTML = sorted.map((p: any) => {
        const pId = p.player_id || p.id;
        return `
        <tr>
          <td>
            <a href="/basketball/players/${currentYear}/${pId}/" class="team-link">
              <strong>${p.name}</strong>
            </a>
          </td>
          <td style="color: var(--text-muted)">${p.position || '—'}</td>
          <td class="num">${fmt(p.offensive_rating)}</td>
          <td class="num">${fmt(p.defensive_rating)}</td>
          <td class="num rating">${fmt(p.net_rating)}</td>
          <td class="num">${getMpg(p)}</td>
          <td style="font-size: 0.8rem; color: var(--text-muted)">${p.status}</td>
        </tr>
      `}).join('');
    }

    renderTable();

    document.querySelectorAll('#rosterTable th.sortable').forEach(th => {
      th.addEventListener('click', () => {
        const key = (th as HTMLElement).dataset.sort;
        if (!key) return;

        if (currentSortKey === key) {
          currentSortDir *= -1;
        } else {
          currentSortKey = key;
          currentSortDir = (key === 'name' || key === 'position' || key === 'status') ? 1 : -1;
        }

        document.querySelectorAll('#rosterTable th.sortable').forEach(el => {
          el.classList.remove('active');
          const icon = el.querySelector('.sort-icon');
          if (icon) icon.textContent = '⇕';
        });
        
        th.classList.add('active');
        const activeIcon = th.querySelector('.sort-icon');
        if (activeIcon) activeIcon.textContent = currentSortDir === 1 ? '▲' : '▼';

        renderTable();
      });
    });
  });
</script>

<style is:global>
  .team-link { color: var(--text); text-decoration: none; transition: color 0.2s ease; }
  .team-link:hover { color: var(--accent-primary); text-decoration: underline; }
  th.sortable { cursor: pointer; user-select: none; transition: color 0.2s; }
  th.sortable:hover { color: var(--accent-primary); }
  th.sortable .sort-icon { display: inline-block; margin-left: 4px; opacity: 0.3; font-size: 0.8em; }
  th.sortable.active .sort-icon { opacity: 1; color: var(--accent-primary); }
</style>