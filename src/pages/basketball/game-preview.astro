---
import Layout from '../../layouts/Layout.astro';
import SportTabs from '../../components/SportTabs.astro';
import GamePreview from '../../components/GamePreview';
import { listBasketballYears } from '../../lib/basketball';

const years = (await listBasketballYears(Astro)).reverse();
const latest = years[0];
const seasonLabel = `${latest - 1}-${String(latest).slice(-2)}`;
---

<Layout title={`Game Preview ${seasonLabel}`} seasonLabel={seasonLabel}>
  <div class="container">
    
    <div style="display: flex; align-items: center; flex-wrap: wrap; gap: 24px; margin-bottom: 24px;">
      <SportTabs />
      
      <div class="tabs" style="margin-bottom: 0;">
        <a href="/basketball/" class="tab-btn" style="text-decoration: none;">Team Rankings</a>
        <a href="/basketball/players/" class="tab-btn" style="text-decoration: none;">Player Leaderboard</a>
        <a href="/basketball/game-preview/" class="tab-btn active" style="text-decoration: none;">Game Preview</a>
      </div>
    </div>

    <GamePreview year={latest} client:visible />
    
  </div>
</Layout>