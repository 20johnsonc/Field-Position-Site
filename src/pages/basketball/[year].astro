---
import Layout from '../../layouts/Layout.astro';
import SportTabs from '../../components/SportTabs.astro';
import BasketballRankingsTable from '../../components/BasketballRankingsTable.astro';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

export const prerender = true;

// 1. Tell Astro which pages to build
export async function getStaticPaths() {
  let years: number[] = [];
  try {
    const indexPath = join(process.cwd(), 'public', 'data', 'basketball', 'index.json');
    const indexData = JSON.parse(readFileSync(indexPath, 'utf-8'));
    years = [...(indexData.years || [])].sort((a, b) => b - a);
  } catch (e) {
    years = [2027]; // Fallback
  }

  // This creates a page for /2024/, /2025/, /2026/, etc.
  return years.map((year) => ({
    params: { year: year.toString() },
    props: { year, allYears: years }
  }));
}

// 2. Get the data for the specific page
const { year, allYears } = Astro.props;
const y = Number(year);

let rankings = null;
try {
  const rankingsPath = join(process.cwd(), 'public', 'data', 'basketball', `${y}/rankings.json`);
  rankings = JSON.parse(readFileSync(rankingsPath, 'utf-8'));
} catch (err) {
  throw new Error(`Missing rankings.json for ${y}. Make sure the file exists at public/data/basketball/${y}/rankings.json`);
}

const conferences = [...new Set(rankings.teams.map((t: any) => t.conference).filter(Boolean))].sort() as string[];

const seasonLabel = `${y - 1}-${String(y).slice(-2)}`;
const stateLabel = rankings.projected ? 'Preseason projection' : 'Final ratings';
---

<Layout title={`Team Rankings ${seasonLabel}`} seasonLabel={seasonLabel}>
  <div class="container">
    
    <div style="display: flex; align-items: center; flex-wrap: wrap; gap: 24px; margin-bottom: 24px;">
      <SportTabs />
      <div class="tabs" style="margin-bottom: 0;">
        <a href={`/basketball/${y}/`} class="tab-btn active" style="text-decoration: none;">Team Rankings</a>
        <a href={`/basketball/players/${y}/`} class="tab-btn" style="text-decoration: none;">Player Leaderboard</a>
        <a href={`/basketball/game-preview/`} class="tab-btn" style="text-decoration: none;">Game Preview</a>
      </div>
    </div>

    <div style="margin-bottom: 24px;">
      <h1 style="font-size: 2rem; margin: 0 0 4px 0; letter-spacing: -0.02em;">College Basketball Ratings</h1>
      <p style="color: var(--text-muted); font-size: 1rem; margin: 0;">
        Player-first RAPM ratings, opponent-adjusted for college basketball.
      </p>
    </div>

    <!-- Controls -->
    <div class="controls" style="display: flex; gap: 16px; margin-bottom: 24px; flex-wrap: wrap; align-items: center; background: var(--surface-1); padding: 16px; border-radius: 8px; border: 1px solid var(--card-border);">
      
      <select id="yearFilter" style="padding: 8px 12px; border-radius: 6px; border: 1px solid var(--card-border); background: var(--surface-2); color: var(--text); font-size: 0.9rem; font-weight: 600; outline: none; cursor: pointer;">
        {allYears.map((yr: number) => (
          <option value={yr} selected={yr === y}>
            {yr - 1}-{String(yr).slice(-2)} Season
          </option>
        ))}
      </select>

      <select id="confFilter" style="padding: 8px 12px; border-radius: 6px; border: 1px solid var(--card-border); background: var(--surface-2); color: var(--text); font-size: 0.9rem; font-weight: 600; outline: none; cursor: pointer;">
        <option value="ALL">All Conferences</option>
        {conferences.map(c => (
          <option value={c}>{c}</option>
        ))}
      </select>

      <input 
        type="text" 
        id="teamSearch" 
        placeholder="Search teams..." 
        style="padding: 8px 12px; border-radius: 6px; border: 1px solid var(--card-border); background: var(--surface-2); color: var(--text); font-size: 0.9rem; outline: none; flex: 1; min-width: 200px; max-width: 300px;"
      />
      
    </div>

    <BasketballRankingsTable 
      teams={rankings.teams} 
      year={y} 
      limit={400} 
      projected={rankings.projected} 
    />

  </div>
</Layout>

<script>
  const yearSelect = document.getElementById('yearFilter') as HTMLSelectElement;
  const confSelect = document.getElementById('confFilter') as HTMLSelectElement;
  const searchInput = document.getElementById('teamSearch') as HTMLInputElement;
  const tableBody = document.getElementById('bballTeamsBody');
  const limitNotice = document.getElementById('bballTeamsLimitNotice'); // NEW

  if (yearSelect) {
    yearSelect.addEventListener('change', (e) => {
      const selectedYear = (e.target as HTMLSelectElement).value;
      window.location.href = `/basketball/${selectedYear}/`;
    });
  }

  function filterTable() {
    if (!tableBody) return;
    
    const search = searchInput?.value.toLowerCase().trim() || '';
    const conf = confSelect?.value || 'ALL';
    const rows = tableBody.querySelectorAll('tr');
    
    let visibleCount = 0;

    rows.forEach(row => {
      const teamName = (row.getAttribute('data-team') || '').toLowerCase();
      const teamConf = row.getAttribute('data-conf') || 'None';
      
      const matchSearch = teamName.includes(search);
      const matchConf = conf === 'ALL' || teamConf === conf;
      
      if (matchSearch && matchConf) {
        (row as HTMLElement).style.display = '';
        visibleCount++;
      } else {
        (row as HTMLElement).style.display = 'none';
      }
    });

    // Hide the "Showing top X" text if actively filtering
    if (limitNotice) {
      if (search !== '' || conf !== 'ALL') {
        limitNotice.style.display = 'none';
      } else {
        limitNotice.style.display = 'block';
      }
    }
  }

  if (searchInput) searchInput.addEventListener('input', filterTable);
  if (confSelect) confSelect.addEventListener('change', filterTable);
</script>