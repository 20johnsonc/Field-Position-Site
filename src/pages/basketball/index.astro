---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

export const prerender = true;

const indexPath = join(process.cwd(), 'public', 'data', 'basketball', 'index.json');
const indexData = JSON.parse(readFileSync(indexPath, 'utf-8'));

// Sort DESCENDING to get the latest year, not the earliest
const years = [...(indexData.years || [])].sort((a, b) => b - a);
const latest = years[0] || 2027;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=/basketball/${latest}/`} />
    <title>Basketball</title>
  </head>
  <body>
    <p>Redirecting to <a href={`/basketball/${latest}/`}>/basketball/{latest}/</a>...</p>
  </body>
</html>