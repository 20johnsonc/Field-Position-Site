---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

export const prerender = false;

let latest = null;
try {
  const indexPath = join(process.cwd(), 'public', 'data', 'basketball', 'index.json');
  const indexData = JSON.parse(readFileSync(indexPath, 'utf-8'));
  const years = [...(indexData.years || [])].sort((a, b) => b - a);
  latest = years[0];
} catch (e) {
  throw new Error("Failed to read basketball index.json at build time");
}

if (!latest) throw new Error("No basketball years found in index.json");

// Instantly redirect to the latest year's URL
return Astro.redirect(`/basketball/${latest}/`);
---