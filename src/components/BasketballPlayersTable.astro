---
import type { BasketballPlayer } from '../lib/basketball';

interface Props {
  players: BasketballPlayer[];
  projected: boolean;
  year: number;
  limit?: number;
}

const { players, projected, limit = 100, year } = Astro.props;
// Render ALL players in the DOM, but hide the ones past the limit
const shown = players; 

const fmt = (v: number | null, d = 1) => v == null ? '—' : v.toFixed(d);
const slugify = (name: any) => String(name || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

const getHeatColor = (val: number | null, min: number, max: number, invert = false) => {
  if (val == null) return 'transparent';
  let pct = (val - min) / (max - min);
  if (invert) pct = 1 - pct;
  pct = Math.max(0, Math.min(1, pct));
  if (pct > 0.5) return `rgba(22, 163, 74, ${Math.min(0.4, (pct - 0.5) * 1.0)})`;
  return `rgba(220, 38, 38, ${Math.min(0.4, (0.5 - pct) * 1.0)})`;
};

const renderStatBadge = (rank: number | null | undefined) => {
  if (!rank || rank > 50) return '';
  let color = '#b45309'; 
  let bg = 'rgba(180, 83, 9, 0.15)';
  if (rank <= 10) { color = '#d97706'; bg = 'rgba(217, 119, 6, 0.15)'; }
  else if (rank <= 25) { color = '#64748b'; bg = 'rgba(100, 116, 139, 0.15)'; }
  return `<span style="font-size: 0.65rem; padding: 1px 4px; border-radius: 4px; margin-left: 4px; font-weight: 800; color: ${color}; background: ${bg}; vertical-align: middle;">#${rank}</span>`;
};

const getRankBadgeHtml = (rank: number) => {
  if (rank <= 10) return `<span style="display:inline-block; background:linear-gradient(135deg,#f59e0b,#d97706); color:#fff; font-weight:900; padding:1px 6px; border-radius:4px; box-shadow:0 2px 8px rgba(217,119,6,0.3);">${rank}</span>`;
  if (rank <= 25) return `<span style="display:inline-block; background:linear-gradient(135deg,#94a3b8,#64748b); color:#fff; font-weight:900; padding:1px 6px; border-radius:4px;">${rank}</span>`;
  return `<span style="color:var(--text-muted); font-weight:600;">${rank}</span>`;
};
---

<div class="table-container" style="position: relative;">
  <table class="rank-table compact-table" id="bballPlayersTable" style="width: 100%; table-layout: fixed;">
    <thead>
      <tr>
        <th class="num" style="width: 40px;">Rk</th>
        <th class="sortable" data-sort="name" style="width: 170px;">Player <span class="sort-icon">⇕</span></th>
        <th class="sortable" data-sort="team" style="width: 160px;">Team <span class="sort-icon">⇕</span></th>
        
        <th class="sortable num" data-sort="offensive_rating" style="width: 70px;">Off RAPM <span class="sort-icon">⇕</span></th>
        <th class="sortable num" data-sort="defensive_rating" style="width: 70px;">Def RAPM <span class="sort-icon">⇕</span></th>
        <th class="sortable num active" data-sort="net_rating" style="width: 70px;">Net RAPM <span class="sort-icon">▼</span></th>
        
        <th class="sortable num" data-sort="pts_pg" style="width: 65px;">PPG <span class="sort-icon">⇕</span></th>
        <th class="sortable num" data-sort="reb_pg" style="width: 65px;">RPG <span class="sort-icon">⇕</span></th>
        <th class="sortable num" data-sort="ast_pg" style="width: 65px;">APG <span class="sort-icon">⇕</span></th>
        
        <th class="sortable" data-sort="position" style="width: 60px; text-align: center;">Pos <span class="sort-icon">⇕</span></th>
      </tr>
    </thead>
    <tbody id="bballPlayersBody">
      {shown.map((p, i) => {
        const ptsHtml = `${fmt(p.pts_pg)}${renderStatBadge(p.pts_pg_rank)}`;
        const rebHtml = `${fmt(p.reb_pg)}${renderStatBadge(p.reb_pg_rank)}`;
        const astHtml = `${fmt(p.ast_pg)}${renderStatBadge(p.ast_pg_rank)}`;

        const offBg = getHeatColor(p.offensive_rating, -1, 5, false);
        const defBg = getHeatColor(p.defensive_rating, -1, 5, false);
        const netBg = getHeatColor(p.net_rating, -2, 8, false);
        const ptsBg = getHeatColor(p.pts_pg, 5, 20, false);
        const rebBg = getHeatColor(p.reb_pg, 2, 10, false);
        const astBg = getHeatColor(p.ast_pg, 1, 6, false);

        return (
          <tr class="bball-player-row" 
              data-player={p.name ? p.name.toLowerCase() : ''} 
              data-team={p.team ? p.team.toLowerCase() : ''}
              data-conf={p.conference || 'None'}
              style={`transition: background-color 0.15s ease; ${i >= limit ? 'display: none;' : ''}`}>
            
            <td class="num" data-val={p.rank} set:html={getRankBadgeHtml(p.rank)}></td>
            
            <td data-val={p.name}>
              <a href={`/basketball/players/${year}/${p.player_id || p.id}/`} class="team-link" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; display: block;">
                <strong>{p.name}</strong>
              </a>
            </td>
            
            <td data-val={p.team} style="color: var(--text-muted); font-size: 0.85rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
              <a href={`/basketball/teams/${year}/${slugify(p.team)}/`} class="team-link">
                {p.team}
              </a>
            </td>
            
            <td class="num" data-val={p.offensive_rating} style={`background: ${offBg};`}>{fmt(p.offensive_rating)}</td>
            <td class="num" data-val={p.defensive_rating} style={`background: ${defBg};`}>{fmt(p.defensive_rating)}</td>
            <td class="num rating" data-val={p.net_rating} style={`background: ${netBg}; font-weight: 800;`}>{fmt(p.net_rating)}</td>
            
            <td class="num" data-val={p.pts_pg} style={`background: ${ptsBg};`} set:html={ptsHtml}></td>
            <td class="num" data-val={p.reb_pg} style={`background: ${rebBg};`} set:html={rebHtml}></td>
            <td class="num" data-val={p.ast_pg} style={`background: ${astBg};`} set:html={astHtml}></td>
            
            <td data-val={p.position} style="color: var(--text-muted); font-size: 0.8rem; text-align: center;">{p.position || '—'}</td>
          </tr>
        );
      })}
    </tbody>
  </table>
  <div id="bballPlayersLimitNotice" style="padding: 12px; text-align: center; font-size: 0.875rem; color: var(--text-muted); border-top: 1px solid var(--card-border);">
    Showing top {limit} of {players.length} players.
  </div>
</div>

<script>
  const table = document.getElementById('bballPlayersTable');
  const tbody = document.getElementById('bballPlayersBody');
  
  if (table && tbody) {
    let currentSort = 'net_rating';
    let currentDir = -1; // -1 = descending, 1 = ascending

    function sortTable(key: string, dir: number) {
      const rows = Array.from(tbody.querySelectorAll('tr'));
      const headers = Array.from(table.querySelectorAll('th'));
      const colIndex = headers.findIndex(th => th.dataset.sort === key);
      if (colIndex === -1) return;

      rows.sort((a, b) => {
        const aVal = (a.children[colIndex] as HTMLElement).dataset.val || '';
        const bVal = (b.children[colIndex] as HTMLElement).dataset.val || '';
        
        const aNum = parseFloat(aVal);
        const bNum = parseFloat(bVal);

        if (!isNaN(aNum) && !isNaN(bNum)) {
          return (aNum - bNum) * dir;
        }
        return aVal.localeCompare(bVal) * dir;
      });

      rows.forEach(row => tbody.appendChild(row));

      headers.forEach(th => {
        th.classList.remove('active');
        const icon = th.querySelector('.sort-icon');
        if (icon) icon.textContent = '⇕';
      });
      const activeTh = headers[colIndex];
      activeTh.classList.add('active');
      const activeIcon = activeTh.querySelector('.sort-icon');
      if (activeIcon) activeIcon.textContent = dir === 1 ? '▲' : '▼';

      // NEW: Re-apply the search and limit after sorting
      if (typeof (window as any).filterPlayersTable === 'function') {
        (window as any).filterPlayersTable();
      }
    }

    table.querySelectorAll('th.sortable').forEach(th => {
      th.addEventListener('click', () => {
        const key = (th as HTMLElement).dataset.sort;
        if (!key) return;

        if (currentSort === key) {
          currentDir *= -1;
        } else {
          currentSort = key;
          currentDir = -1;
        }
        sortTable(currentSort, currentDir);
      });
    });
  }
</script>

<style is:global>
  .compact-table th { padding: 8px 6px !important; }
  .compact-table td { padding: 6px 6px !important; }

  .team-link { color: var(--text); text-decoration: none; transition: color 0.2s ease; }
  .team-link:hover { color: var(--accent-primary); text-decoration: underline; }
  
  th.sortable { cursor: pointer; user-select: none; transition: color 0.2s; font-weight: 700; text-transform: uppercase; font-size: 0.7rem; letter-spacing: 0.05em; color: var(--text-muted); }
  th.sortable:hover { color: var(--accent-primary); }
  th.sortable .sort-icon { display: inline-block; margin-left: 2px; opacity: 0.3; font-size: 0.8em; }
  th.sortable.active .sort-icon { opacity: 1; color: var(--accent-primary); }
  
  .bball-player-row:hover { background-color: var(--surface-2) !important; }
  .rank-table td.num { font-variant-numeric: tabular-nums; font-size: 0.85rem; }
</style>