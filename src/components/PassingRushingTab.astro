---
// src/components/PassingRushingTab.astro
// Needs: src/lib/prFormat.ts, src/lib/prRender.ts (both provided).
//
// Props:
//   teamData  = payload.teams[teamName]     (from public/data/passing-rushing/{year}.json)
//   league    = payload.league
//   teamSlug  = slug for the game-log file (prefer the slug from index.json -> teams[year])
//   gameLogs  = optional; if omitted the client fetches games/{year}/{slug}.json itself,
//               which keeps this page's HTML ~45 KB smaller. (file.games, not the file)
import { slugifyTeam } from '../lib/data';
import { gameLabel } from '../lib/prFormat';
import {
  passGridHtml, rushGridHtml, passUnknownHtml, rushUnknownHtml,
  passSummaryHtml, rushSummaryHtml, passCoverage, rushCoverage,
} from '../lib/prRender';

const { teamData, gameLogs = [], league = null, teamSlug, teamName, year = 2026 } = Astro.props;

const rawTeamName = teamName || '';
const activeSlug = teamSlug || (rawTeamName ? slugifyTeam(rawTeamName) : '');
const baseUrl = (import.meta.env.BASE_URL || '').replace(/\/$/, '');

const ctx = { side: 'offense' as const, isGame: false };
const pOff = teamData?.passing?.offense ?? {};
const rOff = teamData?.rushing?.offense ?? {};
---

<div
  class="pr-wrapper"
  id="pr-wrapper"
  data-team={JSON.stringify(teamData || {})}
  data-games={JSON.stringify(gameLogs || [])}
  data-league={JSON.stringify(league || {})}
  data-slug={activeSlug}
  data-year={year}
  data-base={baseUrl}
>
  <details class="pr-accordion" open>
    <summary class="accordion-header">
      <span class="header-title">
        <svg class="icon blue-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
        </svg>
        Passing &amp; Rushing Location Breakdown
      </span>
      <span class="chevron-icon">
        <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
      </span>
    </summary>

    <div class="accordion-content">

      <!-- Controls -->
      <div class="controls-bar">
        <div class="filter-group">
          <label for="game-select" class="filter-label">Filter View:</label>
          <select id="game-select" class="game-dropdown">
            <option value="season">Full Season Totals</option>
            {gameLogs.map((g, idx) => (
              <option value={idx}>{gameLabel(g)}</option>
            ))}
          </select>
        </div>
        <!-- Tabs (pill toggle, same style as Offense / Defense) -->
        <div class="pr-tabs segmented-control" role="tablist" aria-label="Passing or rushing breakdown">
          <button type="button" role="tab" id="tab-passing" class="pr-tab toggle-btn active" data-tab="passing" aria-selected="true" aria-controls="panel-passing">Passing</button>
          <button type="button" role="tab" id="tab-rushing" class="pr-tab toggle-btn" data-tab="rushing" aria-selected="false" aria-controls="panel-rushing" tabindex="-1">Rushing</button>
        </div>
        <div class="segmented-control">
          <button type="button" id="btn-offense" class="toggle-btn active" aria-pressed="true">Offense</button>
          <button type="button" id="btn-defense" class="toggle-btn" aria-pressed="false">Defense Allowed</button>
        </div>
      </div>

      <p class="side-note hidden" id="side-note">
        Showing what opponents did against this team. Colors are flipped: green means the defense held them below the FBS average.
      </p>


      <!-- Passing tab -->
      <div class="pr-panel" role="tabpanel" id="panel-passing" aria-labelledby="tab-passing">
        <div class="pr-summary" id="pass-summary" set:html={passSummaryHtml(pOff)} />
        <div class="section-toolbar">
          <span class="section-label pass-label">By Target Zone</span>
          <span class="section-hint">Color = success rate vs FBS average</span>
        </div>
        <div class="cards-grid zone-3-col" id="pass-grid" set:html={passGridHtml(pOff, league?.passing, ctx)} />
        <div id="pass-unknown-container" class="wide-card-container" set:html={passUnknownHtml(pOff)} />
        <p class="coverage-note" id="pass-coverage">{passCoverage(pOff)}</p>
      </div>

      <!-- Rushing tab -->
      <div class="pr-panel" role="tabpanel" id="panel-rushing" aria-labelledby="tab-rushing" hidden>
        <div class="pr-summary" id="rush-summary" set:html={rushSummaryHtml(rOff)} />
        <div class="section-toolbar">
          <span class="section-label rush-label">By Direction</span>
          <span class="section-hint">Color = success rate vs FBS average</span>
        </div>
        <div class="cards-grid zone-3-col" id="rush-grid" set:html={rushGridHtml(rOff, league?.rushing, ctx)} />
        <div id="rush-unknown-container" class="wide-card-container" set:html={rushUnknownHtml(rOff)} />
        <p class="coverage-note" id="rush-coverage">{rushCoverage(rOff)}</p>
      </div>

      <!-- Glossary -->
      <details class="pr-legend">
        <summary>What do these stats mean?</summary>
        <dl>
          <dt>Success rate</dt><dd>Share of plays that gained enough to keep the offense on schedule (roughly half the needed yards on 1st down, 70% on 2nd, all of it on 3rd/4th).</dd>
          <dt>PPA</dt><dd>Predicted points added per play: how much each play changed the offense's expected points.</dd>
          <dt>ADOT</dt><dd>Average depth of target: how far downfield the average throw travels in the air.</dd>
          <dt>YAC</dt><dd>Yards gained after the catch.</dd>
          <dt>Explosiveness</dt><dd>How big the successful plays are, on average.</dd>
          <dt>Stuff rate</dt><dd>Share of carries stopped at or behind the line of scrimmage.</dd>
          <dt>Line yards</dt><dd>Rushing yards credited to the offensive line rather than the runner.</dd>
          <dt>Second level / open field</dt><dd>Yards gained beyond the line: the second level is roughly 5-10 yards past the line of scrimmage, open field is farther. The bar under each rushing tile shows each source as a share of the three combined.</dd>
          <dt>#12 (rank)</dt><dd>Season rank among FBS teams with meaningful volume in that spot. #1 is best; on Defense Allowed, #1 allowed the least. Ranks are hidden in single-game views.</dd>
          <dt>Small sample</dt><dd>Fewer than 10 plays in a season (3 in a single game). These tiles are dimmed and not colored.</dd>
          <dt>Defense Allowed</dt><dd>Same stats, but for what opponents did against this team. Lower is better there.</dd>
        </dl>
      </details>

    </div>
  </details>

  <!-- Deep Dive Modal -->
  <div id="zone-modal" class="modal-overlay hidden">
    <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="modal-title">
      <button type="button" id="close-modal" class="modal-close" aria-label="Close">&times;</button>
      <h3 id="modal-title" class="modal-title"></h3>
      <p class="modal-subtitle">Advanced metrics &amp; deep-dive splits</p>
      <div id="modal-content" class="modal-content"></div>
    </div>
  </div>
</div>

<script>
  import { slugifyTeam } from '../lib/data';
  import { gameLabel } from '../lib/prFormat';
  import {
    passGridHtml, rushGridHtml, passUnknownHtml, rushUnknownHtml,
    passSummaryHtml, rushSummaryHtml, passCoverage, rushCoverage, modalHtml, zoneLabel,
  } from '../lib/prRender';

  const wrapper = document.getElementById('pr-wrapper');
  if (wrapper) {
    const $ = (id: string) => document.getElementById(id);
    const btnOff = $('btn-offense');
    const btnDef = $('btn-defense');
    const gameSelect = $('game-select') as HTMLSelectElement | null;
    const modal = $('zone-modal');
    const closeBtn = $('close-modal');
    const modalTitle = $('modal-title');
    const modalContent = $('modal-content');
    const sideNote = $('side-note');

    let currentSide: 'offense' | 'defense' = 'offense';
    let currentGameKey = 'season';

    const seasonData = JSON.parse(wrapper.dataset.team || '{}');
    const league = JSON.parse(wrapper.dataset.league || '{}');
    let gamesData: any[] = JSON.parse(wrapper.dataset.games || '[]');
    const teamSlug = wrapper.dataset.slug || '';
    const year = wrapper.dataset.year || '2026';
    const baseUrl = wrapper.dataset.base || '';

    const getActiveData = () =>
      currentGameKey === 'season' ? seasonData : (gamesData[Number(currentGameKey)] ?? seasonData);

    function populateGameDropdown(games: any[]) {
      if (!gameSelect) return;
      gameSelect.innerHTML = '';
      const first = document.createElement('option');
      first.value = 'season';
      first.textContent = 'Full Season Totals';
      gameSelect.appendChild(first);
      games.forEach((g, idx) => {
        const opt = document.createElement('option');
        opt.value = String(idx);
        opt.textContent = gameLabel(g);
        gameSelect.appendChild(opt);
      });
      gameSelect.value = currentGameKey;
    }

    const setHtml = (id: string, html: string) => { const el = $(id); if (el) el.innerHTML = html; };
    const setText = (id: string, text: string) => { const el = $(id); if (el) el.textContent = text; };

    const render = () => {
      const data = getActiveData();
      const ctx = { side: currentSide, isGame: currentGameKey !== 'season' };
      const p = data?.passing?.[currentSide];
      const r = data?.rushing?.[currentSide];

      const off = currentSide === 'offense';
      btnOff?.classList.toggle('active', off);
      btnDef?.classList.toggle('active', !off);
      btnOff?.setAttribute('aria-pressed', String(off));
      btnDef?.setAttribute('aria-pressed', String(!off));
      sideNote?.classList.toggle('hidden', off);

      setHtml('pass-summary', passSummaryHtml(p));
      setHtml('rush-summary', rushSummaryHtml(r));
      setHtml('pass-grid', passGridHtml(p, league?.passing, ctx));
      setHtml('pass-unknown-container', passUnknownHtml(p));
      setText('pass-coverage', passCoverage(p));
      setHtml('rush-grid', rushGridHtml(r, league?.rushing, ctx));
      setHtml('rush-unknown-container', rushUnknownHtml(r));
      setText('rush-coverage', rushCoverage(r));
    };

    // Game logs: use SSR-provided ones, otherwise fetch this team's file.
    if (gamesData.length > 0) {
      populateGameDropdown(gamesData);
    } else if (teamSlug) {
      const url = `${baseUrl}/data/passing-rushing/games/${year}/${teamSlug}.json`.replace(/\/{2,}/g, '/');
      fetch(url)
        .then((res) => { if (!res.ok) throw new Error(`HTTP ${res.status}`); return res.json(); })
        .then((data) => {
          if (data?.games?.length) { gamesData = data.games; populateGameDropdown(gamesData); }
        })
        .catch((err) => console.warn(`[PassingRushing] no game log for "${teamSlug}" (${url}):`, err.message));
    } else {
      console.warn('[PassingRushing] No teamSlug/teamName passed, so game logs are disabled.');
    }

    btnOff?.addEventListener('click', () => { currentSide = 'offense'; render(); });
    btnDef?.addEventListener('click', () => { currentSide = 'defense'; render(); });
    gameSelect?.addEventListener('change', (e) => {
      currentGameKey = (e.target as HTMLSelectElement).value;
      render();
    });

    // ---- Tabs (Passing / Rushing) --------------------------------------------------
    const tabBtns = Array.from(wrapper.querySelectorAll<HTMLElement>('.pr-tab'));
    const panels: Record<string, HTMLElement | null> = { passing: $('panel-passing'), rushing: $('panel-rushing') };
    const TAB_KEY = 'pr-active-tab';

    const setTab = (name: string, focus = false) => {
      if (!panels[name]) return;
      tabBtns.forEach((t) => {
        const on = t.dataset.tab === name;
        t.classList.toggle('active', on);
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
      });
      Object.entries(panels).forEach(([k, el]) => { if (el) el.hidden = k !== name; });
      try { sessionStorage.setItem(TAB_KEY, name); } catch { /* private mode etc. */ }
    };

    tabBtns.forEach((t, i) => {
      t.addEventListener('click', () => setTab(t.dataset.tab || 'passing'));
      t.addEventListener('keydown', (e) => {
        let next = -1;
        if (e.key === 'ArrowRight') next = (i + 1) % tabBtns.length;
        else if (e.key === 'ArrowLeft') next = (i - 1 + tabBtns.length) % tabBtns.length;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = tabBtns.length - 1;
        if (next >= 0) { e.preventDefault(); setTab(tabBtns[next].dataset.tab || 'passing', true); }
      });
    });

    // Reopen on whichever tab was last used (e.g. when moving between team pages).
    try { setTab(sessionStorage.getItem(TAB_KEY) || 'passing'); } catch { /* keep default */ }

    // ---- Modal ---------------------------------------------------------------------
    let lastFocus: HTMLElement | null = null;

    const openModal = (card: HTMLElement) => {
      const type = card.dataset.type as 'passing' | 'rushing';
      const unknown = card.dataset.unknown === 'true';
      const key = card.dataset.zone || '';
      const data = getActiveData();
      const isGame = currentGameKey !== 'season';

      const name = unknown ? (type === 'passing' ? 'No recorded location' : 'No recorded direction') : zoneLabel(type, key);
      const sideText = currentSide === 'offense' ? 'Offense' : 'Defense allowed';
      if (modalTitle) {
        modalTitle.textContent = `${name} · ${sideText} · ${isGame ? gameLabel(data) : 'Season'}`;
        modalTitle.style.color = type === 'rushing' ? '#10b981' : '#3b82f6';
      }
      if (modalContent) {
        modalContent.innerHTML = modalHtml({
          type, key, unknown, league, side: currentSide, games: gamesData,
          sideObj: data?.[type]?.[currentSide],
        });
      }
      lastFocus = card;
      modal?.classList.remove('hidden');
      closeBtn?.focus();
    };

    const hideModal = () => {
      modal?.classList.add('hidden');
      lastFocus?.focus?.();
    };

    wrapper.addEventListener('click', (e) => {
      const card = (e.target as HTMLElement).closest('.zone-card') as HTMLElement | null;
      if (card) openModal(card);
    });
    wrapper.addEventListener('keydown', (e) => {
      const card = (e.target as HTMLElement).closest?.('.zone-card') as HTMLElement | null;
      if (card && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); openModal(card); }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) hideModal();
    });
    closeBtn?.addEventListener('click', hideModal);
    modal?.addEventListener('click', (e) => { if (e.target === modal) hideModal(); });
  }
</script>

<style>
  .pr-wrapper {
    margin: 1rem 0;
    color: #f1f5f9;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .pr-accordion {
    background: #030712;
    border: 1px solid #1e293b;
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);
  }

  .accordion-header {
    padding: 1rem 1.25rem;
    background: #0f172a;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.875rem;
    font-weight: 600;
    color: #e2e8f0;
    user-select: none;
    transition: background-color 0.2s ease;
  }
  .accordion-header:hover { background: #1e293b; }
  .header-title { display: flex; align-items: center; gap: 0.625rem; }

  .icon { width: 1rem; height: 1rem; color: #94a3b8; transition: transform 0.3s ease; }
  .blue-icon { color: #60a5fa; }
  .pr-accordion[open] .chevron-icon .icon { transform: rotate(180deg); }

  .accordion-content { padding: 1.5rem; border-top: 1px solid #1e293b; background: #030712; }

  /* Controls */
  .controls-bar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    justify-content: space-between;
    align-items: stretch;
    border-bottom: 1px solid #1e293b;
    padding-bottom: 1.25rem;
    margin-bottom: 1.5rem;
  }
  @media (min-width: 640px) { .controls-bar { flex-direction: row; align-items: center; } }

  .filter-group { display: flex; align-items: center; gap: 0.75rem; }
  .filter-label { font-size: 0.75rem; font-weight: 600; color: #94a3b8; text-transform: uppercase; }

  .game-dropdown {
    background: #0f172a;
    color: #f8fafc;
    border: 1px solid #334155;
    padding: 0.4rem 0.75rem;
    border-radius: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    outline: none;
    cursor: pointer;
    transition: border-color 0.2s;
  }
  .game-dropdown:hover, .game-dropdown:focus { border-color: #3b82f6; }

  .segmented-control {
    background: #0f172a;
    padding: 0.25rem;
    border-radius: 0.75rem;
    display: flex;
    gap: 0.25rem;
    border: 1px solid #1e293b;
  }
  .toggle-btn {
    padding: 0.375rem 1rem;
    font-size: 0.75rem;
    font-weight: 700;
    border-radius: 0.5rem;
    color: #94a3b8;
    background: transparent;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .toggle-btn.active { background: #2563eb; color: #ffffff; }
  .toggle-btn:not(.active):hover { color: #ffffff; background: #1e293b; }

  .side-note {
    font-size: 0.75rem;
    color: #94a3b8;
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 0.5rem;
    padding: 0.5rem 0.75rem;
    margin: -0.5rem 0 1rem;
  }
  .side-note.hidden { display: none; }

  /* Summary strip */
  .pr-summary { display: grid; gap: 0.75rem; margin-bottom: 1.5rem; }
  :global(.pr-summary-row) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    align-items: center;
    padding: 0.625rem 0.875rem;
    background: #0b1220;
    border: 1px solid #1e293b;
    border-radius: 0.625rem;
  }
  :global(.pr-summary-title) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: #e2e8f0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    min-width: 5.5rem;
  }

  /* Section headers */
  .section-toolbar { margin-bottom: 1rem; display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .section-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
  }
  .section-hint { font-size: 0.6875rem; color: #64748b; }

  :global(.dot) { width: 0.5rem; height: 0.5rem; border-radius: 9999px; display: inline-block; }
  :global(.blue-dot) { background-color: #3b82f6; box-shadow: 0 0 8px rgba(59, 130, 246, 0.8); }
  :global(.green-dot) { background-color: #10b981; box-shadow: 0 0 8px rgba(16, 185, 129, 0.8); }

  /* Tile grid */
  .cards-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  @media (min-width: 640px) { .cards-grid.zone-3-col { grid-template-columns: repeat(3, 1fr); } }

  :global(.zone-card) {
    /* --tint is set inline per tile (green/red vs FBS average); solid color underneath. */
    background: linear-gradient(var(--tint, transparent), var(--tint, transparent)), #0f172a;
    border: 1px solid #1e293b;
    padding: 1.25rem;
    border-radius: 0.75rem;
    cursor: pointer;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  :global(.zone-card:hover) { transform: translateY(-2px); }
  :global(.zone-card:focus-visible) { outline: 2px solid #60a5fa; outline-offset: 2px; }
  :global(.zone-card.is-thin) { opacity: 0.8; }
  :global(.zone-card.is-empty) { opacity: 0.45; }
  :global(.pass-card:hover) { border-color: rgba(59, 130, 246, 0.5); box-shadow: 0 10px 15px -3px rgba(59, 130, 246, 0.1); }
  :global(.rush-card:hover) { border-color: rgba(16, 185, 129, 0.5); box-shadow: 0 10px 15px -3px rgba(16, 185, 129, 0.1); }

  :global(.card-header) { display: flex; justify-content: space-between; align-items: center; }
  :global(.card-label) { font-size: 0.75rem; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.05em; }

  :global(.share-badge) {
    font-size: 0.6875rem;
    font-weight: 700;
    background: rgba(59, 130, 246, 0.15);
    color: #60a5fa;
    padding: 0.15rem 0.4rem;
    border-radius: 0.375rem;
    border: 1px solid rgba(59, 130, 246, 0.3);
  }
  :global(.green-badge) { background: rgba(16, 185, 129, 0.15); color: #34d399; border-color: rgba(16, 185, 129, 0.3); }

  :global(.card-value) { font-size: 1.875rem; font-weight: 800; margin-top: 0.5rem; color: #ffffff; letter-spacing: -0.025em; }
  :global(.unit) { font-size: 1rem; font-weight: 500; color: #64748b; margin-left: 0.25rem; }
  :global(.card-sub) { font-size: 0.75rem; color: #94a3b8; margin-top: 0.25rem; }

  :global(.int-chip), :global(.thin-chip) {
    margin-left: 0.4rem;
    padding: 0 0.35rem;
    border-radius: 4px;
    font-size: 0.6875rem;
    border: 1px solid currentColor;
    opacity: 0.8;
    white-space: nowrap;
  }
  :global(.int-chip) { color: #f87171; }

  :global(.card-metrics-grid) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    margin-top: 1.25rem;
    padding-top: 0.75rem;
    border-top: 1px solid #1e293b;
  }

  /* Unknown-play banners */
  .wide-card-container { margin-top: 1rem; }
  :global(.wide-card.unknown-card) {
    background: #090d16;
    border: 1px dashed #334155;
    padding: 0.875rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  @media (min-width: 640px) {
    :global(.wide-card.unknown-card) { flex-direction: row; align-items: center; justify-content: space-between; }
  }
  :global(.wide-header) { display: flex; flex-direction: column; gap: 0.15rem; }
  :global(.wide-metrics) { display: flex; flex-wrap: wrap; gap: 1.25rem; }

  :global(.m-item) { display: flex; flex-direction: column; font-size: 0.6875rem; color: #94a3b8; }
  :global(.m-item strong) { font-size: 0.8125rem; color: #ffffff; margin-top: 0.1rem; }

  .coverage-note { font-size: 0.6875rem; color: #64748b; margin: 0.5rem 0 0; }

  /* Tab pill (reuses .segmented-control / .toggle-btn) */
  .pr-tabs.segmented-control { display: inline-flex; }
  .pr-tab { min-width: 6rem; }
  .pr-tab[data-tab="rushing"].active { background: #059669; }
  .pr-tab:focus-visible { outline: 2px solid #60a5fa; outline-offset: 2px; }
