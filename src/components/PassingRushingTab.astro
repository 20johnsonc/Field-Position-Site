---
// src/components/PassingRushingTab.astro
import { slugifyTeam } from '../lib/data';

const { teamData, gameLogs = [], teamSlug, teamName, year = 2026 } = Astro.props;

// Determine the slug using imported slugifyTeam
const rawTeamName = teamName || teamData?.team || "";
const activeSlug = teamSlug || (rawTeamName ? slugifyTeam(rawTeamName) : "");
const baseUrl = (import.meta.env.BASE_URL || '').replace(/\/$/, '');

const PASS_ZONES = [
  { key: "deep left", label: "Deep Left" },
  { key: "deep middle", label: "Deep Middle" },
  { key: "deep right", label: "Deep Right" },
  { key: "short left", label: "Short Left" },
  { key: "short middle", label: "Short Middle" },
  { key: "short right", label: "Short Right" }
];

const RUSH_DIRS = [
  { key: "left", label: "Run Left" },
  { key: "middle", label: "Run Middle" },
  { key: "right", label: "Run Right" }
];

// Access top-level overall stats (or fallback to 0)
const passOverall = teamData?.passing?.offense?.overall || {};
const rushOverall = teamData?.rushing?.offense?.overall || {};
---

<div 
  class="pr-wrapper" 
  id="pr-wrapper" 
  data-team={JSON.stringify(teamData || {})} 
  data-games={JSON.stringify(gameLogs || [])}
  data-slug={activeSlug}
  data-year={year}
  data-base={baseUrl}
>
  <details class="pr-accordion" open>
    <summary class="accordion-header">
      <span class="header-title">
        <svg class="icon blue-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
        </svg>
        Passing & Rushing Location Breakdown
      </span>
      <span class="chevron-icon">
        <svg class="icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
      </span>
    </summary>

    <div class="accordion-content">
      
      <!-- Top Controls Bar -->
      <div class="controls-bar">
        <div class="filter-group">
          <label for="game-select" class="filter-label">Filter View:</label>
          <select id="game-select" class="game-dropdown">
            <option value="season">Full Season Totals</option>
            {gameLogs.map((g, idx) => (
              <option value={idx}>
                Wk {g.week} vs {g.opponent})
              </option>
            ))}
          </select>
        </div>

        <div class="segmented-control">
          <button type="button" id="btn-offense" class="toggle-btn active">Offense</button>
          <button type="button" id="btn-defense" class="toggle-btn">Defense Allowed</button>
        </div>
      </div>

      <!-- Passing Section -->
      <div class="section-toolbar">
        <span class="section-label pass-label">
          <span class="dot blue-dot"></span>
          Passing Targets Breakdown
        </span>
      </div>

      <!-- 3x2 Grid for Spatial Zones -->
      <div class="cards-grid zone-3-col" id="pass-grid">
        {PASS_ZONES.map(({ key, label }) => {
          const z = teamData?.passing?.offense?.zones?.[key] || {};
          const pct = z.success_rate != null ? (z.success_rate * 100).toFixed(1) + '%' : 'N/A';
          return (
            <div class="zone-card pass-card" data-zone={key} data-type="passing" data-unknown="false">
              <div class="card-main">
                <div class="card-header">
                  <span class="card-label">{label}</span>
                  {z.share_of_attempts != null && <span class="share-badge">{z.share_of_attempts}% Share</span>}
                </div>
                <div class="card-value">{z.completion_pct ?? 0}<span class="unit">%</span></div>
                <div class="card-sub">{z.completions ?? 0} / {z.attempts ?? 0} completions</div>
              </div>
              <div class="card-metrics-grid">
                <div class="m-item"><span>Yards</span> <strong>{z.yards ?? 0}</strong></div>
                <div class="m-item"><span>YPA</span> <strong>{z.yards_per_attempt ?? 0}</strong></div>
                <div class="m-item"><span>Success %</span> <strong>{pct}</strong></div>
                <div class="m-item"><span>PPA</span> <strong>{z.ppa ?? 0}</strong></div>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Unknown / Unmapped Passing Banner -->
      <div id="pass-unknown-container" class="wide-card-container">
        {(() => {
          const u = teamData?.passing?.offense?.unknown || {};
          const pct = u.success_rate != null ? (u.success_rate * 100).toFixed(1) + '%' : 'N/A';
          return (
            <div class="zone-card wide-card unknown-card" data-zone="unknown" data-type="passing" data-unknown="true">
              <div class="wide-header">
                <span class="card-label">Unknown / Unmapped Passing</span>
                <span class="card-sub">{u.completions ?? 0} / {u.attempts ?? 0} completions</span>
              </div>
              <div class="wide-metrics">
                <div class="m-item"><span>Yards</span> <strong>{u.yards ?? 0}</strong></div>
                <div class="m-item"><span>YPA</span> <strong>{u.yards_per_attempt ?? 0}</strong></div>
                <div class="m-item"><span>Comp %</span> <strong>{u.completion_pct ?? 0}%</strong></div>
                <div class="m-item"><span>Success %</span> <strong>{pct}</strong></div>
                <div class="m-item"><span>PPA</span> <strong>{u.ppa ?? 0}</strong></div>
              </div>
            </div>
          );
        })()}
      </div>

      <!-- Rushing Section -->
      <div class="rushing-section">
        <div class="section-toolbar">
          <h4 class="section-label rush-label">
            <span class="dot green-dot"></span>
            Rushing Directions Breakdown
          </h4>
        </div>

        <!-- 3-Column Grid for Left / Middle / Right -->
        <div class="cards-grid zone-3-col" id="rush-grid">
          {RUSH_DIRS.map(({ key, label }) => {
            const r = teamData?.rushing?.offense?.directions?.[key] || {};
            const pct = r.success_rate != null ? (r.success_rate * 100).toFixed(1) + '%' : 'N/A';
            const stuff = r.stuff_rate != null ? (r.stuff_rate * 100).toFixed(1) + '%' : 'N/A';
            return (
              <div class="zone-card rush-card" data-zone={key} data-type="rushing" data-unknown="false">
                <div class="card-main">
                  <div class="card-header">
                    <span class="card-label">{label}</span>
                    {r.share_of_carries != null && <span class="share-badge green-badge">{r.share_of_carries}% Share</span>}
                  </div>
                  <div class="card-value">{r.yards ?? 0}<span class="unit">yds</span></div>
                  <div class="card-sub">{r.carries ?? 0} carries</div>
                </div>
                <div class="card-metrics-grid">
                  <div class="m-item"><span>YPC</span> <strong>{r.yards_per_carry ?? 0}</strong></div>
                  <div class="m-item"><span>PPA</span> <strong>{r.ppa ?? 0}</strong></div>
                  <div class="m-item"><span>Success %</span> <strong>{pct}</strong></div>
                  <div class="m-item"><span>Stuff %</span> <strong>{stuff}</strong></div>
                </div>
              </div>
            );
          })}
        </div>

        <!-- Unknown / Unmapped Rushing Banner -->
        <div id="rush-unknown-container" class="wide-card-container">
          {(() => {
            const u = teamData?.rushing?.offense?.unknown || {};
            const pct = u.success_rate != null ? (u.success_rate * 100).toFixed(1) + '%' : 'N/A';
            const stuff = u.stuff_rate != null ? (u.stuff_rate * 100).toFixed(1) + '%' : 'N/A';
            return (
              <div class="zone-card wide-card unknown-card" data-zone="unknown" data-type="rushing" data-unknown="true">
                <div class="wide-header">
                  <span class="card-label">Unknown / Unmapped Rushing</span>
                  <span class="card-sub">{u.carries ?? 0} carries</span>
                </div>
                <div class="wide-metrics">
                  <div class="m-item"><span>Yards</span> <strong>{u.yards ?? 0}</strong></div>
                  <div class="m-item"><span>YPC</span> <strong>{u.yards_per_carry ?? 0}</strong></div>
                  <div class="m-item"><span>PPA</span> <strong>{u.ppa ?? 0}</strong></div>
                  <div class="m-item"><span>Success %</span> <strong>{pct}</strong></div>
                  <div class="m-item"><span>Stuff %</span> <strong>{stuff}</strong></div>
                </div>
              </div>
            );
          })()}
        </div>
      </div>

    </div>
  </details>

  <!-- Deep Dive Modal Dialog -->
  <div id="zone-modal" class="modal-overlay hidden">
    <div class="modal-dialog">
      <button type="button" id="close-modal" class="modal-close">&times;</button>
      <h3 id="modal-title" class="modal-title"></h3>
      <p class="modal-subtitle">Advanced metrics & deep-dive splits</p>
      <div id="modal-content" class="modal-content"></div>
    </div>
  </div>
</div>

<script>
  import { slugifyTeam } from '../lib/data';

  const wrapper = document.getElementById('pr-wrapper');
  if (wrapper) {
    const btnOff = document.getElementById('btn-offense');
    const btnDef = document.getElementById('btn-defense');
    const gameSelect = document.getElementById('game-select');
    const modal = document.getElementById('zone-modal');
    const closeModal = document.getElementById('close-modal');
    const modalTitle = document.getElementById('modal-title');
    const modalContent = document.getElementById('modal-content');
    
    let currentSide = 'offense';
    let currentGameKey = 'season';
    
    const seasonData = JSON.parse(wrapper.dataset.team || '{}');
    let gamesData = JSON.parse(wrapper.dataset.games || '[]');
    let teamSlug = wrapper.dataset.slug;
    const year = wrapper.dataset.year || '2026';
    const baseUrl = wrapper.dataset.base || '';

    // If dataset.slug was empty, try slugifying team from dataset.team
    if (!teamSlug && seasonData.team) {
      teamSlug = slugifyTeam(seasonData.team);
    }

    // Fetch game log file dynamically if gameLogs were not pre-loaded on SSR
    if (gamesData.length === 0 && teamSlug) {
      const fetchUrl = `${baseUrl}/data/passing-rushing/games/${year}/${teamSlug}.json`.replace(/\/+/g, '/');
      console.log(`[PassingRushing] Fetching game logs from: ${fetchUrl}`);

      fetch(fetchUrl)
        .then(res => {
          if (!res.ok) throw new Error(`HTTP ${res.status} file not found`);
          return res.json();
        })
        .then(data => {
          if (data && data.games && data.games.length > 0) {
            gamesData = data.games;
            console.log(`[PassingRushing] Loaded ${gamesData.length} games for ${teamSlug}`);
            populateGameDropdown(gamesData);
          } else {
            console.warn(`[PassingRushing] File found, but zero games inside for ${teamSlug}`);
          }
        })
        .catch(err => {
          console.error(`[PassingRushing] Could not load game logs for slug "${teamSlug}":`, err.message);
        });
    } else if (gamesData.length > 0) {
      populateGameDropdown(gamesData);
    } else {
      console.warn(`[PassingRushing] Warning: No teamSlug found on wrapper. Pass teamSlug="air-force" or teamName="Air Force" to Astro component.`);
    }

    function populateGameDropdown(games) {
      if (!gameSelect) return;
      gameSelect.innerHTML = `<option value="season">Full Season Totals</option>`;
      games.forEach((g, idx) => {
        const opt = document.createElement('option');
        opt.value = idx;
        opt.textContent = `Wk ${g.week} vs ${g.opponent}`;
        gameSelect.appendChild(opt);
      });
    }

    const getActiveData = () => {
      if (currentGameKey === 'season') {
        return seasonData;
      }
      return gamesData[currentGameKey] || seasonData;
    };

    const fmtPct = (val) => val != null ? `${(val * 100).toFixed(1)}%` : 'N/A';
    const fmtNum = (val, decimals = 2) => val != null ? Number(val).toFixed(decimals) : 'N/A';

    const PASS_ZONES = [
      { key: "deep left", label: "Deep Left" },
      { key: "deep middle", label: "Deep Middle" },
      { key: "deep right", label: "Deep Right" },
      { key: "short left", label: "Short Left" },
      { key: "short middle", label: "Short Middle" },
      { key: "short right", label: "Short Right" }
    ];

    const RUSH_DIRS = [
      { key: "left", label: "Run Left" },
      { key: "middle", label: "Run Middle" },
      { key: "right", label: "Run Right" }
    ];

    const render = () => {
      const activeData = getActiveData();

      if (currentSide === 'offense') {
        btnOff?.classList.add('active');
        btnDef?.classList.remove('active');
      } else {
        btnDef?.classList.add('active');
        btnOff?.classList.remove('active');
      }

      // Render Spatial Passing Grid
      const passSideObj = activeData?.passing?.[currentSide] || {};
      const passGrid = document.getElementById('pass-grid');
      
      if (passGrid) {
        passGrid.innerHTML = PASS_ZONES.map(({ key, label }) => {
          const z = passSideObj.zones?.[key] || {};
          return `
            <div class="zone-card pass-card" data-zone="${key}" data-type="passing" data-unknown="false">
              <div class="card-main">
                <div class="card-header">
                  <span class="card-label">${label}</span>
                  ${z.share_of_attempts != null ? `<span class="share-badge">${z.share_of_attempts}% Share</span>` : ''}
                </div>
                <div class="card-value">${z.completion_pct ?? 0}<span class="unit">%</span></div>
                <div class="card-sub">${z.completions ?? 0} / ${z.attempts ?? 0} completions</div>
              </div>
              <div class="card-metrics-grid">
                <div class="m-item"><span>Yards</span> <strong>${z.yards ?? 0}</strong></div>
                <div class="m-item"><span>YPA</span> <strong>${z.yards_per_attempt ?? 0}</strong></div>
                <div class="m-item"><span>Success %</span> <strong>${fmtPct(z.success_rate)}</strong></div>
                <div class="m-item"><span>PPA</span> <strong>${z.ppa ?? 0}</strong></div>
              </div>
            </div>
          `;
        }).join('');
      }

      // Render Unknown Passing Banner
      const passUnknownContainer = document.getElementById('pass-unknown-container');
      if (passUnknownContainer) {
        const u = passSideObj.unknown || {};
        passUnknownContainer.innerHTML = `
          <div class="zone-card wide-card unknown-card" data-zone="unknown" data-type="passing" data-unknown="true">
            <div class="wide-header">
              <span class="card-label">Unknown / Unmapped Passing</span>
              <span class="card-sub">${u.completions ?? 0} / ${u.attempts ?? 0} completions</span>
            </div>
            <div class="wide-metrics">
              <div class="m-item"><span>Yards</span> <strong>${u.yards ?? 0}</strong></div>
              <div class="m-item"><span>YPA</span> <strong>${u.yards_per_attempt ?? 0}</strong></div>
              <div class="m-item"><span>Comp %</span> <strong>${u.completion_pct ?? 0}%</strong></div>
              <div class="m-item"><span>Success %</span> <strong>${fmtPct(u.success_rate)}</strong></div>
              <div class="m-item"><span>PPA</span> <strong>${u.ppa ?? 0}</strong></div>
            </div>
          </div>
        `;
      }

      // Render Spatial Rushing Grid
      const rushSideObj = activeData?.rushing?.[currentSide] || {};
      const rushGrid = document.getElementById('rush-grid');

      if (rushGrid) {
        rushGrid.innerHTML = RUSH_DIRS.map(({ key, label }) => {
          const r = rushSideObj.directions?.[key] || {};
          return `
            <div class="zone-card rush-card" data-zone="${key}" data-type="rushing" data-unknown="false">
              <div class="card-main">
                <div class="card-header">
                  <span class="card-label">${label}</span>
                  ${r.share_of_carries != null ? `<span class="share-badge green-badge">${r.share_of_carries}% Share</span>` : ''}
                </div>
                <div class="card-value">${r.yards ?? 0}<span class="unit">yds</span></div>
                <div class="card-sub">${r.carries ?? 0} carries</div>
              </div>
              <div class="card-metrics-grid">
                <div class="m-item"><span>YPC</span> <strong>${r.yards_per_carry ?? 0}</strong></div>
                <div class="m-item"><span>PPA</span> <strong>${r.ppa ?? 0}</strong></div>
                <div class="m-item"><span>Success %</span> <strong>${fmtPct(r.success_rate)}</strong></div>
                <div class="m-item"><span>Stuff %</span> <strong>${fmtPct(r.stuff_rate)}</strong></div>
              </div>
            </div>
          `;
        }).join('');
      }

      // Render Unknown Rushing Banner
      const rushUnknownContainer = document.getElementById('rush-unknown-container');
      if (rushUnknownContainer) {
        const u = rushSideObj.unknown || {};
        rushUnknownContainer.innerHTML = `
          <div class="zone-card wide-card unknown-card" data-zone="unknown" data-type="rushing" data-unknown="true">
            <div class="wide-header">
              <span class="card-label">Unknown / Unmapped Rushing</span>
              <span class="card-sub">${u.carries ?? 0} carries</span>
            </div>
            <div class="wide-metrics">
              <div class="m-item"><span>Yards</span> <strong>${u.yards ?? 0}</strong></div>
              <div class="m-item"><span>YPC</span> <strong>${u.yards_per_carry ?? 0}</strong></div>
              <div class="m-item"><span>PPA</span> <strong>${u.ppa ?? 0}</strong></div>
              <div class="m-item"><span>Success %</span> <strong>${fmtPct(u.success_rate)}</strong></div>
              <div class="m-item"><span>Stuff %</span> <strong>${fmtPct(u.stuff_rate)}</strong></div>
            </div>
          </div>
        `;
      }
    };

    // Event Listeners
    btnOff?.addEventListener('click', () => { currentSide = 'offense'; render(); });
    btnDef?.addEventListener('click', () => { currentSide = 'defense'; render(); });
    gameSelect?.addEventListener('change', (e) => {
      currentGameKey = e.target.value;
      render();
    });

    const modalRow = (label, value) => `
      <div class="modal-row">
        <span>${label}</span>
        <strong>${value}</strong>
      </div>
    `;

    // Modal Interaction
    wrapper.addEventListener('click', (e) => {
      const card = e.target.closest('.zone-card');
      if (!card) return;

      const zoneKey = card.dataset.zone;
      const isRushing = card.dataset.type === 'rushing';
      const isUnknown = card.dataset.unknown === 'true';
      const activeData = getActiveData();
      
      const gameLabel = currentGameKey === 'season' ? 'Season Totals' : `Wk ${activeData.week} vs ${activeData.opponent}`;
      const titleLabel = isUnknown ? 'Unknown / Unmapped' : zoneKey;
      modalTitle.textContent = `${titleLabel} (${currentSide.toUpperCase()}) — ${gameLabel}`;
      modalTitle.style.color = isRushing ? '#10b981' : '#3b82f6';

      if (!isRushing) {
        const passSideObj = activeData?.passing?.[currentSide] || {};
        const z = isUnknown ? (passSideObj.unknown || {}) : (passSideObj.zones?.[zoneKey] || {});
        modalContent.innerHTML = `
          ${modalRow('Completion Pct', `${z.completion_pct ?? 0}%`)}
          ${modalRow('Completions / Attempts', `${z.completions ?? 0} / ${z.attempts ?? 0}`)}
          ${z.share_of_attempts != null ? modalRow('Share of Pass Attempts', `${z.share_of_attempts}%`) : ''}
          ${modalRow('Total Yards', `${z.yards ?? 0} yds`)}
          ${modalRow('Yards Per Attempt (YPA)', `${z.yards_per_attempt ?? 0}`)}
          ${modalRow('Yards Per Completion', `${z.yards_per_completion ?? 0}`)}
          ${modalRow('Air Yards', `${z.air_yards ?? 0}`)}
          ${modalRow('ADOT (Avg Depth of Target)', `${z.adot ?? 'N/A'}`)}
          ${modalRow('YAC (Yards After Catch)', `${z.yac ?? 0}`)}
          ${modalRow('YAC / Completion', `${z.yac_per_completion ?? 'N/A'}`)}
          ${modalRow('Interceptions (INT Rate)', `${z.interceptions ?? 0} (${z.int_rate ?? 0}%)`)}
          ${modalRow('Success Rate', fmtPct(z.success_rate))}
          ${modalRow('PPA (Predicted Points Added)', fmtNum(z.ppa, 4))}
          ${modalRow('Explosiveness', fmtNum(z.explosiveness, 4))}
        `;
      } else {
        const rushSideObj = activeData?.rushing?.[currentSide] || {};
        const r = isUnknown ? (rushSideObj.unknown || {}) : (rushSideObj.directions?.[zoneKey] || {});
        modalContent.innerHTML = `
          ${modalRow('Total Yards', `${r.yards ?? 0} yds`)}
          ${modalRow('Total Carries', `${r.carries ?? 0}`)}
          ${r.share_of_carries != null ? modalRow('Share of Rush Carries', `${r.share_of_carries}%`) : ''}
          ${modalRow('Yards Per Carry (YPC)', `${r.yards_per_carry ?? 0}`)}
          ${modalRow('Success Rate', fmtPct(r.success_rate))}
          ${modalRow('PPA (Predicted Points Added)', fmtNum(r.ppa, 4))}
          ${modalRow('Explosiveness', fmtNum(r.explosiveness, 4))}
          ${modalRow('Stuff Rate', fmtPct(r.stuff_rate))}
          ${modalRow('Power Success Rate', fmtPct(r.power_success))}
          ${modalRow('Line Yards', fmtNum(r.line_yards, 2))}
          ${modalRow('Second Level Yards', fmtNum(r.second_level_yards, 2))}
          ${modalRow('Open Field Yards', fmtNum(r.open_field_yards, 2))}
        `;
      }

      modal?.classList.remove('hidden');
    });

    const hideModal = () => modal?.classList.add('hidden');
    closeModal?.addEventListener('click', hideModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) hideModal();
    });
  }
</script>

<style>
  .pr-wrapper {
    margin: 1rem 0;
    color: #f1f5f9;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .pr-accordion {
    background: #030712;
    border: 1px solid #1e293b;
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);
  }

  .accordion-header {
    padding: 1rem 1.25rem;
    background: #0f172a;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.875rem;
    font-weight: 600;
    color: #e2e8f0;
    user-select: none;
    transition: background-color 0.2s ease;
  }

  .accordion-header:hover {
    background: #1e293b;
  }

  .header-title {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .icon {
    width: 1rem;
    height: 1rem;
    color: #94a3b8;
    transition: transform 0.3s ease;
  }

  .blue-icon {
    color: #60a5fa;
  }

  .pr-accordion[open] .chevron-icon .icon {
    transform: rotate(180deg);
  }

  .accordion-content {
    padding: 1.5rem;
    border-top: 1px solid #1e293b;
    background: #030712;
  }

  /* Controls Bar */
  .controls-bar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    justify-content: space-between;
    align-items: stretch;
    border-bottom: 1px solid #1e293b;
    padding-bottom: 1.25rem;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 640px) {
    .controls-bar {
      flex-direction: row;
      align-items: center;
    }
  }

  .filter-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .filter-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: #94a3b8;
    text-transform: uppercase;
