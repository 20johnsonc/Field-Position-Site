---
import MatchupCard from './MatchupCard.astro';
import MatchupRow from './MatchupRow.astro';
import type { Matchup } from '../lib/types';
import { resolveMatchupConferences } from '../lib/data';
import type { BacktestResult } from '../lib/betting';
import type { DisplayPlay } from '../lib/pbp';

interface Props {
  matchups: Matchup[];
  teamConfMap: Record<string, string>;
  backtestByGame?: Map<number, BacktestResult>;
  topPlaysByGame?: Record<string, DisplayPlay[]>;
}

const { matchups, teamConfMap, backtestByGame, topPlaysByGame = {} } = Astro.props;

const completed = matchups.filter((g) => g.homePoints !== undefined && g.awayPoints !== undefined);
const upcoming = matchups.filter((g) => g.homePoints === undefined || g.awayPoints === undefined);

const pbpDataJson = JSON.stringify(topPlaysByGame).replace(/</g, '\\u003c');
---

<div class="panel" id="topPlaysWrapper">
  <button type="button" class="panel-toggle" id="topPlaysToggle" aria-expanded="false">
    <span class="panel-title">
      Top 10 Plays This Week
      <span class="panel-count" id="topPlaysToggleCount"></span>
    </span>
    <svg class="panel-chev" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
      <polyline points="9 6 15 12 9 18" />
    </svg>
  </button>
  <div class="panel-body">
    <div id="topPlaysPanel">
      <div class="empty">No notable plays yet.</div>
    </div>
  </div>
</div>

<script id="pbp-week-data" type="application/json" set:html={pbpDataJson} />

<div id="matchupGrid" class="grid">
  {
    upcoming.map((game) => {
      const { homeConf, awayConf } = resolveMatchupConferences(game, teamConfMap);
      const backtest = backtestByGame?.get(game.gameId);
      return <MatchupCard game={game} homeConf={homeConf} awayConf={awayConf} backtest={backtest} />;
    })
  }
</div>

<div id="matchupRowList" class="row-list">
  {
    completed.map((game) => {
      const { homeConf, awayConf } = resolveMatchupConferences(game, teamConfMap);
      const backtest = backtestByGame?.get(game.gameId);
      const topPlays = (topPlaysByGame[String(game.gameId)] ?? []).slice(0, 5);
      return (
        <MatchupRow
          game={game}
          homeConf={homeConf}
          awayConf={awayConf}
          backtest={backtest}
          topPlays={topPlays}
        />
      );
    })
  }
</div>

<div id="matchupEmptyState" class="empty empty-state">No games found for the selected filters.</div>

<style is:global>
  /* =========================================
     Top Plays Panel
     ========================================= */

  .row-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-bottom: 5px;
    align-items: start;
  }

  .panel {
    background: var(--card-bg);
    backdrop-filter: blur(12px);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    margin-bottom: 20px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
  }

  .panel-toggle {
    all: unset;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 14px 18px;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .panel-toggle:hover {
    background: color-mix(
      in srgb,
      var(--text) 4%,
      transparent
    );
  }

  .panel-toggle:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: -2px;
  }

  .panel-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .panel-count {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-muted);
  }

  .panel-chev {
    color: var(--text-muted);
    transition: transform 0.15s ease;
    flex-shrink: 0;
  }

  #topPlaysWrapper.expanded .panel-chev {
    transform: rotate(90deg);
  }

  .panel-body {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.2s ease;
  }

  #topPlaysWrapper.expanded .panel-body {
    max-height: 3000px;
    padding: 0 18px 16px;
  }

  /* =========================================
     Light Mode Panel
     ========================================= */

  [data-theme="light"] .panel {
    background: #ffffff;
    border-color: rgba(15, 23, 42, 0.10);
    box-shadow: 0 4px 18px rgba(15, 23, 42, 0.06);
  }

  [data-theme="light"] .panel-toggle:hover {
    background: #f8fafc;
  }
</style>

<style is:global>
  /* =========================================
     Top Plays List
     ========================================= */

  .week-plays-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .week-play-item {
    display: flex;
    align-items: center;
    gap: 10px;

    background: color-mix(
      in srgb,
      var(--text) 4%,
      var(--card-bg)
    );

    border: 1px solid var(--card-border);
    border-radius: 8px;
    padding: 8px 12px;

    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .week-play-item:hover {
    background: color-mix(
      in srgb,
      var(--accent-primary) 5%,
      var(--card-bg)
    );

    border-color: var(--card-border-hover);
  }

  .week-play-rank {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    border-radius: 999px;

    background: color-mix(
      in srgb,
      var(--text) 7%,
      transparent
    );

    color: var(--text-muted);
    font-size: 11px;
    font-weight: 700;

    display: flex;
    align-items: center;
    justify-content: center;
  }

  .week-play-body {
    flex: 1;
    min-width: 0;
  }

  .week-play-matchup {
    color: var(--text-dim);
    font-size: 11px;
    margin-bottom: 2px;
  }

  .week-play-text {
    color: var(--text);
    font-size: 13px;
    line-height: 1.3;
  }

  .week-play-impact {
    flex-shrink: 0;
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
  }

  .week-play-impact.offense {
    color: var(--accent-success);
  }

  .week-play-impact.defense {
    color: var(--accent-primary);
  }

  /* =========================================
     Light Mode Top Plays
     ========================================= */

  [data-theme="light"] .week-play-item {
    background: #f8fafc;
    border-color: rgba(15, 23, 42, 0.08);
  }

  [data-theme="light"] .week-play-item:hover {
    background: #f1f5f9;
    border-color: var(--card-border-hover);
  }

  [data-theme="light"] .week-play-rank {
    background: #e2e8f0;
    color: var(--text-muted);
  }

  [data-theme="light"] .week-play-impact.offense {
    color: var(--accent-success);
  }

  [data-theme="light"] .week-play-impact.defense {
    color: var(--accent-primary);
  }
</style>