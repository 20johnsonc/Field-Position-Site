---
import type { FilterOptions } from '../lib/types';

interface Props {
  filters: FilterOptions;
  conferences?: string[];
}

const { filters, conferences = [] } = Astro.props;
---

<div class="tabs" id="dashboardTabs">
  <button type="button" class="tab-btn active" data-tab="rankings">Power Rankings</button>
  <button type="button" class="tab-btn" data-tab="matchups">Matchup Slate</button>
  <a href="/futures" class="tab-btn" style="text-decoration: none; display: inline-flex; align-items: center;">
    2026 Futures
  </a>
</div>

<!-- Power Rankings Panel (Default Active) -->
<div id="rankingsPanel" class="tab-panel active">
  <div class="controls">
    <select id="rankingsYearFilter" aria-label="Filter rankings by year">
      {
        filters.rankingYears.map((year) => (
          <option value={year} selected={String(year) === "2026"}>{year}</option>
        ))
      }
    </select>

    <!-- HIDDEN SELECT: Keeps dashboard-controls.ts functional -->
    <select id="rankingsConfFilter" style="display: none;" aria-hidden="true">
      <option value="ALL">ALL</option>
      {conferences.map(conf => (
        <option value={conf}>{conf}</option>
      ))}
    </select>

    <!-- Visual Conference Pills -->
    <div class="conf-pills" id="indexConfPills">
      <button type="button" class="pill active" data-conf="ALL">ALL</button>
      {conferences.map(conf => (
        <button type="button" class="pill" data-conf={conf}>{conf}</button>
      ))}
    </div>
  </div>
  <slot name="rankings" />
</div>

<!-- Matchups Panel (Hidden on Load) -->
<div id="matchupsPanel" class="tab-panel">
  <div class="controls">
    <select id="matchupYearFilter" aria-label="Filter matchups by year">
      {
        filters.matchupYears.map((year) => (
          <option value={year} selected={String(year) === "2026"}>{year}</option>
        ))
      }
    </select>

    <!-- HIDDEN SELECT: Keeps dashboard-controls.ts functional for matchups -->
    <select id="confFilter" style="display: none;" aria-hidden="true">
      <option value="ALL">All Conferences</option>
      {
        filters.matchupConferences.map((conf) => (
          <option value={conf}>{conf}</option>
        ))
      }
    </select>

    <select id="weekFilter" aria-label="Filter matchups by week">
      {
        filters.matchupWeeks.map((week) => (
          <option value={week} selected={String(week) === "0"}>
            Week {week}
          </option>
        ))
      }
    </select>

    <!-- Live SU% / ATS% record for the current filter selection (year + week + conference) -->
    <div class="record-stats" id="matchupRecordStats">
      <span class="season-label">Week</span>
      <div class="stat-pill" id="suStatPill">
        <span class="stat-pill-label">SU</span>
        <span class="stat-pill-value" id="suStatValue">—</span>
      </div>
      <div class="stat-pill" id="atsStatPill">
        <span class="stat-pill-label">ATS</span>
        <span class="stat-pill-value" id="atsStatValue">—</span>
      </div>
    </div>

    <!-- Full-season SU% / ATS% for the selected year, independent of week/conference -->
    <div class="record-stats season-stats" id="matchupSeasonStats">
      <span class="season-label">Season</span>
      <div class="stat-pill" id="suSeasonPill">
        <span class="stat-pill-label">SU</span>
        <span class="stat-pill-value" id="suSeasonValue">—</span>
      </div>
      <div class="stat-pill" id="atsSeasonPill">
        <span class="stat-pill-label">ATS</span>
        <span class="stat-pill-value" id="atsSeasonValue">—</span>
      </div>
    </div>

    <!-- Visual Conference Pills for Matchups -->
    <div class="conf-pills" id="matchupConfPills">
      <button type="button" class="pill active" data-conf="ALL">ALL</button>
      {
        filters.matchupConferences.map((conf) => (
          <button type="button" class="pill" data-conf={conf}>{conf}</button>
        ))
      }
    </div>
  </div>
  <slot name="matchups" />
</div>

<style>
  .record-stats {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  #matchupRecordStats {
    margin-left: auto;
  }

  .season-stats {
    margin-left: 12px;
    padding-left: 12px;
    border-left: 1px solid rgba(255, 255, 255, 0.1);
  }

  .season-label {
    font-size: 11px;
    color: var(--text-secondary, rgba(255, 255, 255, 0.5));
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-right: 2px;
  }

  .stat-pill {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .stat-pill-label {
    opacity: 0.6;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .stat-pill-value {
    font-weight: 700;
    color: #67e8f9;
  }

  .stat-pill.no-data .stat-pill-value {
    color: rgba(255, 255, 255, 0.4);
  }

  @media (max-width: 720px) {
    #matchupRecordStats,
    .season-stats {
      margin-left: 0;
      padding-left: 0;
      border-left: none;
      width: 100%;
      justify-content: flex-start;
    }
  }
</style>

<script>
  import { initDashboardControls } from '../scripts/dashboard-controls';

  document.addEventListener('DOMContentLoaded', () => {
    // 1. Initialize core dashboard controls
    initDashboardControls();

    const rankingsYear = document.getElementById('rankingsYearFilter') as HTMLSelectElement | null;
    const matchupYear = document.getElementById('matchupYearFilter') as HTMLSelectElement | null;
    const week = document.getElementById('weekFilter') as HTMLSelectElement | null;
    const rankingsConf = document.getElementById('rankingsConfFilter') as HTMLSelectElement | null;
    const matchupConf = document.getElementById('confFilter') as HTMLSelectElement | null;

    // 2. Bridge pill clicks to the hidden selects, and sync URL on any change
    const setupPillBridge = (pillContainerId: string, hiddenSelectId: string) => {
      const pills = document.querySelectorAll(`#${pillContainerId} .pill`);
      const hiddenSelect = document.getElementById(hiddenSelectId) as HTMLSelectElement | null;

      pills.forEach(pill => {
        pill.addEventListener('click', () => {
          pills.forEach(p => p.classList.remove('active'));
          pill.classList.add('active');

          const selectedConf = (pill as HTMLElement).dataset.conf || 'ALL';

          if (hiddenSelect) {
            hiddenSelect.value = selectedConf;
            hiddenSelect.dispatchEvent(new Event('change', { bubbles: true }));
          }
        });
      });
    };

    setupPillBridge('indexConfPills', 'rankingsConfFilter');
    setupPillBridge('matchupConfPills', 'confFilter');

    // 3. Apply filter state from the URL on load
    const params = new URLSearchParams(window.location.search);
    const yr = params.get('year');
    const conf = params.get('conference');
    const wk = params.get('week');
    const tab = params.get('tab');

    function setAndFire(el: HTMLSelectElement | null, value: string) {
      if (!el) return;
      el.value = value;
      el.dispatchEvent(new Event('change', { bubbles: true }));
    }

    if (yr) {
      setAndFire(rankingsYear, yr);
      setAndFire(matchupYear, yr);
    }
    if (wk) setAndFire(week, wk);

    if (conf) {
      const applyConfToPills = (containerId: string, hiddenSelect: HTMLSelectElement | null) => {
        document.querySelectorAll(`#${containerId} .pill`).forEach(p => {
          p.classList.toggle('active', (p as HTMLElement).dataset.conf === conf);
        });
        setAndFire(hiddenSelect, conf);
      };
      applyConfToPills('indexConfPills', rankingsConf);
      applyConfToPills('matchupConfPills', matchupConf);
    }

    if (tab === 'matchups') {
      document.querySelector<HTMLButtonElement>('[data-tab="rankings"]')?.classList.remove('active');
      document.querySelector<HTMLButtonElement>('[data-tab="matchups"]')?.classList.add('active');
      document.getElementById('rankingsPanel')?.classList.remove('active');
      document.getElementById('matchupsPanel')?.classList.add('active');
    }

    // 4. Push current filter state to the URL (used for the back-link and shareability)
    function syncURL() {
      const activeTab = document.getElementById('matchupsPanel')?.classList.contains('active') ? 'matchups' : 'rankings';
      const newParams = new URLSearchParams();

      const currentYear = activeTab === 'matchups' ? matchupYear?.value : rankingsYear?.value;
      const currentConf = activeTab === 'matchups' ? matchupConf?.value : rankingsConf?.value;

      if (currentYear) newParams.set('year', currentYear);
      if (currentConf && currentConf !== 'ALL') newParams.set('conference', currentConf);
      if (activeTab === 'matchups' && week?.value) newParams.set('week', week.value);
      if (activeTab === 'matchups') newParams.set('tab', 'matchups');

      const qs = newParams.toString();
      window.history.replaceState({}, '', qs ? `?${qs}` : window.location.pathname);
    }

    [rankingsYear, matchupYear, week, rankingsConf, matchupConf].forEach(el => {
      el?.addEventListener('change', syncURL);
    });

    document.querySelectorAll('.tab-btn[data-tab]').forEach(btn => {
      btn.addEventListener('click', syncURL);
    });
  });
</script>