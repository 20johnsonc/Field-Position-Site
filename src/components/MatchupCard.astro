---
import type { Matchup } from '../lib/types';
import { fmtDate } from '../lib/data';
import { fmtSpread, pickTeamName, type BacktestResult } from '../lib/betting';
import { slugifyTeam } from '../lib/data';

interface Props {
  game: Matchup;
  homeConf?: string;
  awayConf?: string;
  backtest?: BacktestResult;
}

const {
  game,
  homeConf = (game as any).home_conference || game.homeConference || 'Other',
  awayConf = (game as any).away_conference || game.awayConference || 'Other',
  backtest,
} = Astro.props;

// 1. Determine score & completion state using normalized fields
const hasScores = game.homePoints !== undefined && game.awayPoints !== undefined;
const isUpcoming = !hasScores;

let scoreDisplay = '—';
if (hasScores) {
  scoreDisplay = `${game.awayTeam} ${game.awayPoints} - ${game.homePoints} ${game.homeTeam}`;
} else if (game.predictedScore) {
  scoreDisplay = game.predictedScore;
}

// 2. Win Probability Calculation (0-100%)
let homeWinProbNum: number | null = null;
if (game.homeWinProb != null && !isNaN(game.homeWinProb)) {
  let raw = game.homeWinProb;
  if (raw <= 1.0 && raw > 0) {
    raw = raw * 100;
  }
  homeWinProbNum = Math.min(Math.max(raw, 0), 100);
}
let awayWinProbNum: number | null = null;
if (game.awayWinProb != null && !isNaN(game.awayWinProb)) {
  let raw = game.awayWinProb;
  if (raw <= 1.0 && raw > 0) {
    raw = raw * 100;
  }
  awayWinProbNum = Math.min(Math.max(raw, 0), 100);
}

// 3. Analytics calculations
const modelSpread = game.predictedMargin != null ? game.predictedMargin : null;
const predTotal = game.predictedTotal ?? (hasScores ? (game.homePoints! + game.awayPoints!) : null);
const dateTag = fmtDate(game.startDate);

// 4. Backtest result helpers
const hasBacktest = !isUpcoming && !!backtest;
const suPickTeam = backtest ? pickTeamName(game, backtest.su_pick) : null;
const atsPickTeam = backtest ? pickTeamName(game, backtest.ats_pick) : null;
const suClass = backtest ? (backtest.su_correct ? 'correct' : 'incorrect') : '';
const atsClass = backtest ? (backtest.ats_correct ? 'correct' : 'incorrect') : '';
---

<article
  class="card matchup-card"
  data-year={game.year}
  data-week={game.week}
  data-home-conf={homeConf}
  data-away-conf={awayConf}
  data-game-id={game.gameId}
  data-home-team={game.homeTeam}
  data-away-team={game.awayTeam}
  data-has-backtest={hasBacktest ? 'true' : 'false'}
  data-su-correct={hasBacktest ? String(backtest!.su_correct) : undefined}
  data-ats-correct={hasBacktest ? String(backtest!.ats_correct) : undefined}
>
  <!-- Header -->
  <header class="card-head">
    <div class="week-tag">
      <span>WK {game.week}</span>
      {dateTag && <span class="dot-sep">•</span>}
      {dateTag && <time>{dateTag}</time>}
    </div>
  </header>

  <!-- Card Body -->
  <div class="card-body">
    
    <!-- Grouped Matchup & Gauge Grid -->
    <div class="matchup-grid">
      <!-- Away Side -->
      <div class="team-col">
        <a href={`/teams/${game.year}/${slugifyTeam(game.awayTeam)}/`} class="team-link" title={game.awayTeam}>
          <span class="away-team">{game.awayTeam}</span>
        </a>
        {awayWinProbNum !== null && (
          <div
            class="prob-gauge"
            style={`--prob: ${awayWinProbNum}%;`}
            title={`${game.awayTeam} Win Probability: ${awayWinProbNum.toFixed(1)}%`}
          >
            <div class="gauge-center">
              <span>{Math.round(awayWinProbNum)}%</span>
            </div>
          </div>
        )}
      </div>

      <!-- Center Divider -->
      <div class="vs-divider">@</div>

      <!-- Home Side -->
      <div class="team-col">
        <a href={`/teams/${game.year}/${slugifyTeam(game.homeTeam)}/`} class="team-link" title={game.homeTeam}>
          <span class="home-team">{game.homeTeam}</span>
        </a>
        {homeWinProbNum !== null && (
          <div
            class="prob-gauge"
            style={`--prob: ${homeWinProbNum}%;`}
            title={`${game.homeTeam} Win Probability: ${homeWinProbNum.toFixed(1)}%`}
          >
            <div class="gauge-center">
              <span>{Math.round(homeWinProbNum)}%</span>
            </div>
          </div>
        )}
      </div>
    </div>

    <!-- Analytics Section (Upcoming Games) -->
    {
      isUpcoming && game.predictedMargin !== undefined && (
        <div class="analytics-grid">
          <div class="stat-box">
            <span class="stat-label">Spread</span>
            <div class="stat-comparison">
              <span class="mkt">
                <small>MKT</small>{' '}
                {game.marketSpread != null ? game.marketSpread : <span class="na">N/A</span>}
              </span>
              <span class="divider">/</span>
              <span class="model">
                <small>MODEL</small> <strong>{fmtSpread(modelSpread)}</strong>
              </span>
            </div>
          </div>

          <div class="stat-box">
            <span class="stat-label">Total</span>
            <div class="stat-comparison">
              <span class="mkt">
                <small>MKT</small>{' '}
                {game.marketTotal != null ? game.marketTotal : <span class="na">N/A</span>}
              </span>
              <span class="divider">/</span>
              <span class="model">
                <small>MODEL</small> <strong>{predTotal != null ? Number(predTotal).toFixed(1) : 'N/A'}</strong>
              </span>
            </div>
          </div>
        </div>
      )
    }

    <!-- Backtest Results Section (Completed Games w/ backtest data) -->
    {
      hasBacktest && backtest && (
        <div class="analytics-grid results-grid">
          <div class:list={['stat-box', 'result-box', suClass]}>
            <span class="stat-label">Straight Up</span>
            <div class="stat-comparison">
              <span class="mkt">
                <small>PICK</small> {suPickTeam}
              </span>
              <span class="divider">/</span>
              <span class={`verdict-badge ${suClass}`}>
                {backtest.su_correct ? '✓ Correct' : '✗ Wrong'}
              </span>
            </div>
          </div>

          <div class:list={['stat-box', 'result-box', atsClass]}>
            <span class="stat-label">Spread (ATS)</span>
            <div class="stat-comparison">
              <span class="mkt">
                <small>MKT</small> {fmtSpread(backtest.market_spread)}
              </span>
              <span class="divider">/</span>
              <span class="model">
                <small>MODEL</small> <strong>{fmtSpread(backtest.predicted_margin)}</strong>
              </span>
            </div>
            <div class="actual-line">
              <small>ACTUAL</small> <strong>{fmtSpread(backtest.actual_margin)}</strong>
              <span class="pick-note">Pick: {atsPickTeam} ({backtest.ats_correct ? '✓' : '✗'})</span>
            </div>
          </div>
        </div>
      )
    }

    <!-- Action Section (Completed Games) -->
    {
      !isUpcoming && (
        <div class="verdict">
          <button
            type="button"
            class="pbp-btn"
            data-pbp-trigger
            data-game-id={game.gameId}
            data-year={game.year}
            data-home-team={game.homeTeam}
            data-away-team={game.awayTeam}
          >
            <svg class="btn-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="18" y1="20" x2="18" y2="10" />
              <line x1="12" y1="20" x2="12" y2="4" />
              <line x1="6" y1="20" x2="6" y2="14" />
            </svg>
            <span>View Play-by-Play Chart</span>
          </button>
        </div>
      )
    }
  </div>
</article>

<style>
  /* Tightened padding to remove the large header-to-body gap */
  .card-head {
    padding: 0 0 6px 0;
    border-bottom: 1px solid var(--card-border);
    margin-bottom: 0px;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* Grid layout for team names & win probability gauges */
  .matchup-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid var(--card-border);
    padding: 12px;
    border-radius: 12px;
  }

  .team-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
    min-width: 0;
  }

  .vs-divider {
    color: var(--text-dim);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .team-link {
    color: var(--text);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    display: block;
    width: 100%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.2s ease;
  }
  
  .team-link:hover {
    color: var(--accent-primary);
  }

  /* Result Box styles */
  .result-box.correct {
    border-color: rgba(34, 197, 94, 0.35);
    background: rgba(34, 197, 94, 0.06);
  }
  .result-box.correct::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 100%;
    background: #4ade80;
  }
  .result-box.correct .stat-label {
    color: #4ade80;
  }
  .result-box.correct .model strong {
    color: #86efac;
  }

  .result-box.incorrect {
    border-color: rgba(239, 68, 68, 0.35);
    background: rgba(239, 68, 68, 0.06);
  }
  .result-box.incorrect::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 100%;
    background: #f87171;
  }
  .result-box.incorrect .stat-label {
    color: #f87171;
  }
  .result-box.incorrect .model strong {
    color: #fca5a5;
  }

  .result-box {
    position: relative;
    overflow: hidden;
  }

  .verdict-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-weight: 700;
    font-size: 0.8rem;
    padding: 2px 8px;
    border-radius: 999px;
  }
  .verdict-badge.correct {
    color: #4ade80;
    background: rgba(34, 197, 94, 0.15);
  }
  .verdict-badge.incorrect {
    color: #f87171;
    background: rgba(239, 68, 68, 0.15);
  }

  .actual-line {
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.75rem;
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  .actual-line small {
    opacity: 0.55;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-size: 0.65rem;
  }
  .actual-line strong {
    font-size: 0.85rem;
  }
  .pick-note {
    margin-left: auto;
    opacity: 0.65;
    font-size: 0.7rem;
  }
</style>