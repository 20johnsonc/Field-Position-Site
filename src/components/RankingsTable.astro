---
import type { Ranking } from '../lib/types';
import { formatRating, slugifyTeam } from '../lib/data';

interface Props {
  rankings: Ranking[];
}

const { rankings } = Astro.props;

// Helper to convert "10-2" into a numeric value for accurate sorting
const getRecordSortValue = (record: string) => {
  if (!record || !record.includes('-')) return 0;
  
  const [wins, losses] = record.split('-').map(Number);
  const total = wins + losses;
  
  if (total === 0) return 0;
  
  // Win Percentage + tiny tiebreaker for total wins
  return (wins / total) + (wins * 0.0001);
};
---

<div class="table-container">
  <table class="rank-table" id="rankingsTable">
    <thead>
      <tr>
        <th class="sortable" data-sort-key="rank">Rk ⇕</th>
        <th class="sortable" data-sort-key="team">Team</th>
        <th class="sortable num" data-sort-key="netRating" style="text-align: right;">Net Rating</th>
        <th class="sortable num" data-sort-key="record" style="text-align: right;">Record</th>
        <th class="sortable num" data-sort-key="sos" style="text-align: right;">SOS</th>
        <th class="sortable num" data-sort-key="sor" style="text-align: right;">SOR</th>
        <th class="sortable" data-sort-key="conference">Conf</th>
        <th class="text-right">Style Tags</th>
      </tr>
    </thead>
    <tbody id="rankingsBody">
      {
        rankings.map((row) => (
          <tr
            data-year={row.year}
            data-team={row.team}
            data-rank={row.rank}
            data-record={getRecordSortValue(row.record)}
            data-net-rating={row.netRating}
            data-sos={row.sos_rank}
            data-sor={row.sor}
            data-conference={row.conference}
          >
            <td class="rank">{row.rank}</td>
            <td class="team">
              <a href={`/teams/${row.year}/${slugifyTeam(row.team)}/`} class="team-link">
                {row.team}
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-top: 2px;"><path d="m9 18 6-6-6-6"/></svg>
              </a>
            </td>
            <td class="num rating">{formatRating(row.netRating)}</td>
            <td class="num">{row.record}</td>
            <td class="num" title={`Rating: ${row.sos}`}>{row.sos_rank}</td>
            <td class="num" title={`Rating: ${row.sor}`}>{row.sor}</td>
            <td>{row.conference}</td>
            <td class="text-right">
              {row.tags && row.tags.length > 0 ? (
                <div class="table-tags">
                  {row.tags.slice(0, 3).map((tag: string) => {
                    const lower = tag.toLowerCase();
                    const isDef = lower.includes('defense') || lower.includes('stout') || lower.includes('break');
                    const isOff = lower.includes('offense') || lower.includes('explosive') || lower.includes('run');
                    const tagClass = isDef ? 'mini-defense' : (isOff ? 'mini-offense' : 'mini-neutral');
                    
                    return <span class={`mini-tag ${tagClass}`}>{tag}</span>;
                  })}
                  
                  {row.tags.length > 3 && (
                    <span class="mini-tag mini-counter" title={row.tags.slice(3).join(', ')}>
                      +{row.tags.length - 3} more
                    </span>
                  )}
                </div>
              ) : (
                <span class="text-muted">—</span>
              )}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
<div id="rankingsEmptyState" class="empty empty-state">No rankings found matching filters.</div>

<style>
  .team-link,
  .team-link:visited {
    color: #ffffff; 
    text-decoration: none;
  }

  .team-link:hover {
    color: #93c5fd; 
  }

  .text-right {
    text-align: right;
  }

  .table-tags {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
  }

  .mini-tag {
    font-size: 0.65rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Counter Badge Style */
  .mini-counter {
    background: rgba(255, 255, 255, 0.05);
    color: #94a3b8;
    border: 1px solid rgba(255, 255, 255, 0.1);
    cursor: default;
  }

  /* Compact Offense Theme */
  .mini-offense {
    background: rgba(20, 184, 166, 0.15);
    color: #2dd4bf;
    border: 1px solid rgba(45, 212, 191, 0.3);
  }

  /* Compact Defense Theme */
  .mini-defense {
    background: rgba(245, 158, 11, 0.15);
    color: #fbbf24;
    border: 1px solid rgba(251, 191, 36, 0.3);
  }

  /* Compact Neutral Theme */
  .mini-neutral {
    background: rgba(168, 85, 247, 0.15);
    color: #c084fc;
    border: 1px solid rgba(192, 132, 252, 0.3);
  }
</style>