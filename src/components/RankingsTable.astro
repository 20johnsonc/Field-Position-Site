---
import type { Ranking } from '../lib/types';
import { formatRating } from '../lib/data';

interface Props {
  rankings: Ranking[];
}

const { rankings } = Astro.props;
---

<div class="table-container">
  <table class="rank-table" id="rankingsTable">
    <thead>
      <tr>
        <th class="sortable" data-sort-key="rank"># ⇕</th>
        <th class="sortable" data-sort-key="team">Team ⇕</th>
        <th class="sortable" data-sort-key="conference">Conf ⇕</th>
        <th class="sortable" data-sort-key="year">Year ⇕</th>
        <th class="sortable num" data-sort-key="netRating" style="text-align: right;">Net Rating ⇕</th>
        <th class="sortable num" data-sort-key="offRating" style="text-align: right;">Off Rating ⇕</th>
        <th class="sortable num" data-sort-key="defRating" style="text-align: right;">Def Rating ⇕</th>
      </tr>
    </thead>
    <tbody id="rankingsBody">
      {
        rankings.map((row) => (
          <tr
            data-year={row.year}
            data-conference={row.conference}
            data-team={row.team}
            data-rank={row.rank}
            data-net-rating={row.netRating}
            data-off-rating={row.offRating}
            data-def-rating={row.defRating}
          >
            <td class="rank">{row.rank}</td>
            <td class="team">{row.team}</td>
            <td>{row.conference}</td>
            <td>{row.year}</td>
            <td class="num rating">{formatRating(row.netRating)}</td>
            <td class="num">{row.offRating.toFixed(1)}</td>
            <td class="num">{row.defRating.toFixed(1)}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
<div id="rankingsEmptyState" class="empty empty-state">No rankings found matching filters.</div>
