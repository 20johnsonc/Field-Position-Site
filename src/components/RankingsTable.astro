---
import type { Ranking } from '../lib/types';
import { formatRating, slugifyTeam } from '../lib/data';

interface Props {
  rankings: Ranking[];
}

const { rankings } = Astro.props;

// Helper to convert "10-2" into a numeric value for accurate sorting
const getRecordSortValue = (record: string) => {
  if (!record || !record.includes('-')) return -1;

  const [wins, losses] = record.split('-').map(Number);
  const total = wins + losses;

  if (total === 0) return -0.0001; // Distinct value for 0-0 so it doesn't collide with 0-1 (0.0)

  // Win Percentage + tiny tiebreaker for total wins
  return (wins / total) + (wins * 0.0001);
};

// Position decides the style: tags[0] = offense, tags[1] = defense, tags[2] = other.
// Anything past the third tag goes into the "+N more" badge.
const TAG_CLASSES = ['mini-offense', 'mini-defense', 'mini-neutral'];
---

<div class="table-container">
  <table class="rank-table" id="rankingsTable">
    <thead>
      <tr>
        <th class="sortable" data-sort-key="rank">Rk ⇕</th>
        <th class="sortable" data-sort-key="team">Team</th>
        <th class="sortable num" data-sort-key="netRating" style="text-align: center;">Net Rating</th>
        <th class="sortable num" data-sort-key="record" style="text-align: center;">Record</th>
        <th class="sortable num" data-sort-key="conference_record" style="text-align: center;">Conf Record</th>
        <th class="sortable num" data-sort-key="sos" style="text-align: center;">SOS</th>
        <th class="sortable num" data-sort-key="sor" style="text-align: center;">SOR</th>
        <th class="sortable" data-sort-key="conference" style="text-align: left;">Conf</th>
        {/*<th class="text-right">Style Tags</th>*/}
      </tr>
    </thead>
    <tbody id="rankingsBody">
      {
        rankings.map((row) => {
          const tags: string[] = row.tags ?? [];
          const shown = tags.slice(0, 3);
          const extra = tags.slice(3);

          return (
            <tr
              data-year={row.year}
              data-team={row.team}
              data-rank={row.rank}
              data-record={getRecordSortValue(row.record)}
              data-conference-record={getRecordSortValue(row.conference_record)}
              data-net-rating={row.netRating}
              data-sos={row.sos_rank}
              data-sor={row.sor_rank}
              data-conference={row.conference}
            >
              <td class="rank">
                <span class="rank-num">{row.rank}</span>
              </td>
              <td class="team">
                <a href={`/teams/${row.year}/${slugifyTeam(row.team)}/`} class="team-link">
                  {row.team}
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-top: 2px;"><path d="m9 18 6-6-6-6"/></svg>
                  <div class="rank-wrapper">
                    {row.rank_change != null && (
                      <span
                        class={`rank-change ${Number(row.rank_change) > 0 ? 'up' : Number(row.rank_change) < 0 ? 'down' : 'neutral'}`}
                        title={row.previous_rank ? `Previous Rank: ${row.previous_rank}` : 'No change'}
                      >
                        {Number(row.rank_change) > 0 ? '▲' : Number(row.rank_change) < 0 ? '▼' : ''}
                        {Number(row.rank_change) !== 0 ? <span class="change-val">{Math.abs(Number(row.rank_change))}</span> : ''}
                      </span>
                    )}
                  </div>
                </a>
              </td>
              <td class="num rating">{formatRating(row.netRating)}</td>
              <td class="num">{row.record}</td>
              <td class="num">{row.conference_record}</td>
              <td class="num" title={`Rating: ${row.sos}`}>{row.sos_rank}</td>
              <td class="num" title={`Rating: ${row.sor}`}>{row.sor_rank}</td>
              <td>{row.conference}</td>
              {/*
              <td class="text-right">
                {shown.length > 0 ? (
                  <div class="table-tags">
                    {shown.map((tag, i) => (
                      <span class={`mini-tag ${TAG_CLASSES[i]}`} title={tag}>{tag}</span>
                    ))}
                    {extra.length > 0 && (
                      <span class="mini-tag mini-counter" title={extra.join(', ')}>
                        +{extra.length} more
                      </span>
                    )}
                  </div>
                ) : (
                  <span class="text-muted">—</span>
                )}
              </td>
              */}
            </tr>
          );
        })
      }
    </tbody>
  </table>
</div>
<div id="rankingsEmptyState" class="empty empty-state">No rankings found matching filters.</div>

<style>
  /* --- New Rank Indicator Styles --- */
  .rank-wrapper {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .rank-num {
    min-width: 20px; /* Keeps arrows aligned if single/double digits change */
  }

  .rank-change {
    display: flex;
    align-items: center;
    gap: 2px;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .rank-change.up {
    color: var(--accent-success);
  }

  .rank-change.down {
    color: var(--accent-danger);
  }

  .rank-change.neutral {
    color: var(--text-muted);
    font-weight: 900;
  }
  /* --------------------------------- */

  .team-link,
  .team-link:visited {
    color: var(--text); /* Fix for invisible text in light mode */
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 4px;
    transition: color 0.2s ease;
  }

  .team-link:hover {
    color: var(--accent-primary);
  }

  .text-right {
    text-align: right;
  }

  .text-muted {
    opacity: 0.5;
  }

  .table-tags {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
  }

  .mini-tag {
    font-size: 0.65rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    /* Offense tags can be long; truncate and show the full text on hover */
    max-width: 300px;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Counter Badge Style - Dark Mode Defaults */
  .mini-counter {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-muted);
    border: 1px solid rgba(255, 255, 255, 0.1);
    cursor: default;
  }

  /* Compact Offense Theme */
  .mini-offense {
    background: rgba(20, 184, 166, 0.15);
    color: #2dd4bf;
    border: 1px solid rgba(45, 212, 191, 0.3);
  }

  /* Compact Defense Theme */
  .mini-defense {
    background: rgba(245, 158, 11, 0.15);
    color: #fbbf24;
    border: 1px solid rgba(251, 191, 36, 0.3);
  }

  /* Compact Neutral Theme */
  .mini-neutral {
    background: rgba(168, 85, 247, 0.15);
    color: #c084fc;
    border: 1px solid rgba(192, 132, 252, 0.3);
  }

  /* =========================================
     Light Mode Overrides (Includes Astro :global support)
     ========================================= */
  :global([data-theme="light"]) .mini-counter,
  [data-theme="light"] .mini-counter {
    background: rgba(0, 0, 0, 0.04);
    border-color: rgba(0, 0, 0, 0.08);
    color: var(--text-dim);
  }

  :global([data-theme="light"]) .mini-offense,
  [data-theme="light"] .mini-offense {
    background: rgba(13, 148, 136, 0.1);
    color: #0f766e; /* Darker teal for contrast */
    border-color: rgba(13, 148, 136, 0.2);
  }

  :global([data-theme="light"]) .mini-defense,
  [data-theme="light"] .mini-defense {
    background: rgba(217, 119, 6, 0.1);
    color: #b45309; /* Darker amber for contrast */
    border-color: rgba(217, 119, 6, 0.2);
  }

  :global([data-theme="light"]) .mini-neutral,
  [data-theme="light"] .mini-neutral {
    background: rgba(126, 34, 206, 0.1);
    color: #6b21a8; /* Darker purple for contrast */
    border-color: rgba(126, 34, 206, 0.2);
  }
</style>