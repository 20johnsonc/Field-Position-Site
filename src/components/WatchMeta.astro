---
// One-line meta strip for a game: [watchability pill] [kickoff] [channel].
// Drop <WatchMeta game={game} /> inside MatchupCard.astro (upcoming games).
import type { Matchup } from '../lib/types';
import { watchTier, kickoffTimeHtml, channelLabel } from '../lib/watchability';

interface Props { game: Matchup }
const { game } = Astro.props;

const score = game.watchabilityScore;
const tier = watchTier(score);
const tip = score !== undefined
  ? `Watchability ${score.toFixed(1)} / 100${game.watchabilityRank ? ` · #${game.watchabilityRank} this week` : ''}`
  : '';
const chan = channelLabel(game);


---

<div class="wm-row">
  {tier && score !== undefined && (
    <span class={`wm-score wm-${tier.tier}`} title={tip} aria-label={tip}>
      <span class="wm-score-num">{Math.round(score)}</span>
      <span class="wm-score-label">{tier.label}</span>
    </span>
  )}
  <Fragment set:html={kickoffTimeHtml(game)} />
  <span class:list={['wm-chan', !game.tvChannel && 'wm-chan-tbd']} title={game.tvAll && game.tvAll.length > 1 ? game.tvAll.join(', ') : undefined}>{chan}</span>
</div>

<style is:global>
  /* =========================================================
     WIN / MATCHUP META
     Layout and component behavior only.
     Colors come from the global theme tokens.
     ========================================================= */

  .wm-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    font-size: 0.8rem;
  }

  .wm-score {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    padding: 0.05rem 0.45rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-weight: 600;
    line-height: 1.3;
  }

  .wm-score-num {
    font-variant-numeric: tabular-nums;
  }

  .wm-score-label {
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  /* Semantic result colors */
  .wm-marquee {
    color: var(--wm-marquee);
  }

  .wm-strong {
    color: var(--wm-strong);
  }

  .wm-solid {
    color: var(--wm-solid);
  }

  .wm-light {
    color: var(--text);
  }

  .wm-kickoff {
    font-variant-numeric: tabular-nums;
    color: var(--text);
  }

  .wm-tbd,
  .wm-chan-tbd {
    opacity: 0.7;
  }

  .wm-time-chan {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .wm-chan {
    padding: 0.1rem 0.5rem;
    border-radius: 0.35rem;
    background: var(--surface-3);
    color: var(--text-muted);
  }

  /* =========================================================
     TOOLBAR
     ========================================================= */

  .wm-toolbar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.75rem;
    font-size: 0.85rem;
  }

  .wm-toolbar[hidden] {
    display: none;
  }

  .wm-toolbar button {
    padding: 0.2rem 0.65rem;
    border: 1px solid var(--card-border);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
    opacity: 0.7;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease,
      opacity 0.15s ease;
  }

  .wm-toolbar button:hover {
    opacity: 1;
    background: var(--surface-hover);
    border-color: var(--card-border-strong);
  }

  .wm-toolbar button:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }

  .wm-toolbar button[aria-pressed="true"] {
    opacity: 1;
    font-weight: 600;
    background: var(--surface-active);
    border-color: var(--card-border-strong);
  }

  @media (prefers-reduced-motion: reduce) {
    .wm-toolbar button {
      transition: none;
    }
  }
</style>