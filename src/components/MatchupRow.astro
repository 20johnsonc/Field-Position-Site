---
import type { Matchup } from '../lib/types';
import { fmtDate } from '../lib/data';
import { fmtSpread, pickTeamName, type BacktestResult } from '../lib/betting';
import { slugifyTeam } from '../lib/data';
import { getPlayImpact, formatEpa, type TaggedPlay } from '../lib/pbp';

interface Props {
  game: Matchup;
  homeConf?: string;
  awayConf?: string;
  backtest?: BacktestResult;
  topPlays?: TaggedPlay[];
}

const {
  game,
  homeConf = (game as any).home_conference || game.homeConference || 'Other',
  awayConf = (game as any).away_conference || game.awayConference || 'Other',
  backtest,
  topPlays = [],
} = Astro.props;

const dateTag = fmtDate(game.startDate);

const hasBacktest = !!backtest;
const suPickTeam = backtest ? pickTeamName(game, backtest.su_pick) : null;
const atsPickTeam = backtest ? pickTeamName(game, backtest.ats_pick) : null;
const suClass = backtest ? (backtest.su_correct ? 'win' : 'loss') : '';
const atsClass = backtest ? (backtest.ats_correct ? 'win' : 'loss') : '';

const isAwayWinner = game.awayPoints > game.homePoints;
const isHomeWinner = game.homePoints > game.awayPoints;
---

<div
  class="matchup-card row-wrap"
  data-year={game.year}
  data-week={game.week}
  data-home-conf={homeConf}
  data-away-conf={awayConf}
  data-game-id={game.gameId}
  data-home-team={game.homeTeam}
  data-away-team={game.awayTeam}
  data-has-backtest={hasBacktest ? 'true' : 'false'}
  data-su-correct={hasBacktest ? String(backtest!.su_correct) : undefined}
  data-ats-correct={hasBacktest ? String(backtest!.ats_correct) : undefined}
>
  <button type="button" class="game-row" data-row-trigger aria-expanded="false">
    
    <!-- Left: Stacked Team Rows -->
    <div class="teams-stack">
      <div class="team-row">
        <a href={`/teams/${game.year}/${slugifyTeam(game.awayTeam)}/`} class={`team-link ${isAwayWinner ? 'winner' : 'loser'}`} onclick="event.stopPropagation()">
          {game.awayTeam}
        </a>
        <span class={`score-num ${isAwayWinner ? 'winner' : 'loser'}`}>{game.awayPoints}</span>
      </div>
      <div class="team-row">
        <a href={`/teams/${game.year}/${slugifyTeam(game.homeTeam)}/`} class={`team-link ${isHomeWinner ? 'winner' : 'loser'}`} onclick="event.stopPropagation()">
          {game.homeTeam}
        </a>
        <span class={`score-num ${isHomeWinner ? 'winner' : 'loser'}`}>{game.homePoints}</span>
      </div>
    </div>

    <!-- Right: Bet Results & Chevron -->
    <div class="right-col">
      <div class="results">
        {
          hasBacktest && backtest ? (
            <>
              <span class={`tag ${suClass}`}>
                <small>SU</small> {backtest.su_correct ? '✓' : '✗'}
              </span>
              <span class={`tag ${atsClass}`}>
                <small>ATS</small> {backtest.ats_correct ? '✓' : '✗'}
              </span>
            </>
          ) : (
            <span class="pill-muted">—</span>
          )
        }
      </div>
      <span class="chev" aria-hidden="true">›</span>
    </div>

  </button>

  <div class="row-detail">
    {
      hasBacktest && backtest && (
        <div class="detail-grid">
          <div class="detail-box">
            <span class="dl">Straight up</span>
            <div>
              Pick: <strong>{suPickTeam}</strong> —{' '}
              <span class={suClass === 'win' ? 'txt-win' : 'txt-loss'}>
                {backtest.su_correct ? 'Correct' : 'Wrong'}
              </span>
            </div>
          </div>
          <div class="detail-box">
            <span class="dl">Spread (ATS)</span>
            <div>MKT {fmtSpread(backtest.market_spread)} / MODEL {fmtSpread(backtest.predicted_margin)}</div>
            <div>
              Actual {fmtSpread(backtest.actual_margin)} — Pick: {atsPickTeam} (
              <span class={atsClass === 'win' ? 'txt-win' : 'txt-loss'}>{backtest.ats_correct ? '✓' : '✗'}</span>)
            </div>
          </div>
        </div>
      )
    }

    {
      topPlays.length > 0 && (
        <div class="plays-box">
          <span class="dl">Top Plays (EPA)</span>
          <ol class="plays-list">
            {topPlays.map((play, index) => {
              const impact = getPlayImpact(play);
              return (
                <li class="play-item">
                  <span class="play-rank">{index + 1}</span>
                  <span class="play-text">{play.playText}</span>
                  {impact && (
                    <span class={`play-impact ${impact.role}`}>
                      {impact.icon} {impact.team} {formatEpa(impact.value)}
                    </span>
                  )}
                </li>
              );
            })}
          </ol>
        </div>
      )
    }

    <button
      type="button"
      class="pbp-btn"
      data-pbp-trigger
      data-game-id={game.gameId}
      data-year={game.year}
      data-home-team={game.homeTeam}
      data-away-team={game.awayTeam}
    >
      <svg class="btn-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="20" x2="18" y2="10" />
        <line x1="12" y1="20" x2="12" y2="4" />
        <line x1="6" y1="20" x2="6" y2="14" />
      </svg>
      <span>View Play-by-Play Chart</span>
    </button>
  </div>
</div>

<style>
  .row-wrap {
    background: var(--panel, #0d1117);
    border: 1px solid var(--border-color, rgba(255, 255, 255, 0.08));
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 8px;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .row-wrap:hover {
    border-color: rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.01);
  }

  .game-row {
    display: flex;
    align-items: center;
    justify-content: space-between; /* Distributes the 3 children across the row */
    width: 100%;
    padding: 12px 16px;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 12px;
    cursor: pointer;
    text-align: left;
    gap: 16px;
  }
  
  .game-row:focus-visible {
    outline: 2px solid #38bdf8;
    outline-offset: -2px;
  }

  /* Stacked Team Rows */
  .teams-stack {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .team-row {
    display: grid;
    grid-template-columns: minmax(0, 150px) auto;
    align-items: center;
    gap: 16px;
    min-width: 0;
  }
  
  .team-link {
    font-size: 13.5px;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: #f8fafc;
    transition: color 0.15s ease;
  }
  .team-link.winner {
    font-weight: 700;
  }
  .team-link.loser {
    font-weight: 400;
  }
  .team-link:hover {
    color: #38bdf8 !important;
    text-decoration: none;
  }

  .score-num {
    font-size: 14px;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .score-num.winner {
    color: #f8fafc;
    font-weight: 700;
  }
  .score-num.loser {
    color: #94a3b8;
    font-weight: 400;
  }

  /* Metadata Column */
  .meta-col {
    display: flex;
    flex-direction: column;
    gap: 2px;
    align-items: flex-start;
  }
  .wk-pill {
    background: rgba(255, 255, 255, 0.05);
    color: #cbd5e1;
    font-size: 10.5px;
    font-weight: 600;
    padding: 2px 6px;
    border-radius: 4px;
    letter-spacing: 0.02em;
  }
  .date-text {
    font-size: 11px;
    color: #64748b;
    white-space: nowrap;
  }

  /* Right Column */
  .right-col {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .results {
    display: flex;
    gap: 6px;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: 11px;
    font-weight: 700;
    padding: 3px 7px;
    border-radius: 5px;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .tag small {
    font-size: 9px;
    letter-spacing: 0.04em;
    opacity: 0.7;
  }
  .tag.win {
    color: #4ade80;
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.2);
  }
  .tag.loss {
    color: #f87171;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.2);
  }
  .pill-muted {
    font-size: 12px;
    color: #475569;
  }

  .chev {
    font-size: 16px;
    color: #64748b;
    line-height: 1;
    transition: transform 0.2s ease, color 0.2s ease;
  }
  .game-row:hover .chev {
    color: #cbd5e1;
  }
  .row-wrap.expanded .chev {
    transform: rotate(90deg);
    color: #cbd5e1;
  }

  /* Expandable Detail Panel */
  .row-detail {
    display: none;
    padding: 12px 16px 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(0, 0, 0, 0.2);
  }
  .row-wrap.expanded .row-detail {
    display: block;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 12px;
    font-size: 12px;
  }
  .detail-box {
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 6px;
    padding: 8px 10px;
    background: rgba(255, 255, 255, 0.01);
  }
  .dl {
    display: block;
    font-size: 9.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #64748b;
    margin-bottom: 4px;
    font-weight: 600;
  }
  .txt-win {
    color: #4ade80;
    font-weight: 700;
  }
  .txt-loss {
    color: #f87171;
    font-weight: 700;
  }

  .plays-box {
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 6px;
    padding: 8px 10px;
    margin-bottom: 12px;
    background: rgba(255, 255, 255, 0.01);
  }
  .plays-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .play-item {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 11.5px;
  }
  .play-rank {
    flex-shrink: 0;
    color: #475569;
    font-weight: 700;
    width: 12px;
  }
  .play-text {
    flex: 1;
    color: #cbd5e1;
    line-height: 1.3;
  }
  .play-impact {
    flex-shrink: 0;
    font-weight: 700;
    white-space: nowrap;
    font-size: 10.5px;
  }
  .play-impact.offense {
    color: #4ade80;
  }
  .play-impact.defense {
    color: #60a5fa;
  }

  .pbp-btn {
    all: unset;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    padding: 8px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    font-size: 11.5px;
    font-weight: 500;
    color: #cbd5e1;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .pbp-btn:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.15);
    color: #f8fafc;
  }

  @media (max-width: 640px) {
    .game-row {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .right-col {
      width: 100%;
      justify-content: space-between;
      justify-self: stretch;
      margin-left: 0;
    }
    .meta-col {
      flex-direction: row;
      align-items: center;
      gap: 8px;
    }
    .detail-grid {
      grid-template-columns: 1fr;
    }
  }
</style>