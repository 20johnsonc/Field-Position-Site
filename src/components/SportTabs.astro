---
import { fetchJson } from '../lib/basketball';

const { pathname } = Astro.url;
const isBasketball = pathname.startsWith('/basketball');

// 1. Fetch the index to find the latest year
const indexData = await fetchJson(Astro, '/data/basketball/index.json');

// 2. Sort descending to get the latest (e.g., 2027)
const years = [...(indexData?.years || [])].sort((a, b) => b - a);
const latest = years[0] || 2027;

// 3. Generate the direct link
const basketballLink = `/basketball/${latest}/`;
---

<div class="sport-tabs">
  <a href="/" class={`sport-tab ${!isBasketball ? 'active' : ''}`}>
    Football
  </a>
  <a href={basketballLink} class={`sport-tab ${isBasketball ? 'active' : ''}`}>
    Basketball
  </a>
</div>

<style>
  .sport-tabs {
    display: flex;
    gap: 8px;
  }
  .sport-tab {
    background: var(--surface-2);
    border: 1px solid var(--card-border);
    color: var(--text-muted);
    padding: 6px 16px;
    border-radius: 20px;
    font-family: inherit;
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .sport-tab:hover {
    color: var(--text);
    background: var(--surface-hover);
    border-color: var(--card-border-strong);
  }
  .sport-tab.active {
    background: var(--accent-primary);
    color: var(--bg);
    border-color: var(--accent-primary);
    box-shadow: 0 0 12px var(--glow-primary);
  }
  [data-theme="light"] .sport-tab.active {
    color: #ffffff;
  }
</style>
